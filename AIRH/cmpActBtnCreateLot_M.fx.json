- cmpActBtnCreateLot_M:
    Control: CanvasComponent
    ComponentName: cmpActionButton
    Properties:
      AccessibleLabel: ="Bouton de création d'un lot"
      Action: =_ActionOnList.CreateLot
      ActionState: |-
        =// Détermine l'état métier courant de l'action.
        // L'action est considérée comme :
        // • Applied     si le processus associé est déjà actif ;
        // • Available   lorsqu'au moins une demande éligible est disponible ;
        // • Unavailable dans tous les autres cas.
        If(
            vcCurrentProcess = Self.Action,
            Self.StateValues.Applied,
            If(vcCurrentProcess <> Blank(),
                Self.StateValues.Unavailable,
                If(
                    !IsEmpty(
                        Filter(
                            ccDemandes_V2,
                            Statut_x0020_Detail = _StatutDetail.DACValidee
                        )
                    ),
                    Self.StateValues.Available,
                    Self.StateValues.Unavailable
                )
            )
        )
      BasePaletteColor: =
      EligibleItemsCount: =CountRows( Filter( ccDemandes_V2,Statut_x0020_Detail in [ _StatutDetail.DACValidee ]))
      Height: =32
      Icon: ="AppsList"
      InteractionEnabled: =true
      NextStatus: =Blank()
      OnApplied: =Select(btnLotCancel_M); //Annler Le processus
      OnAvailable: |-
        =// ## Logique métier de lancemnt d'un process
        With(
            {
                MyProcess :         Self.Action,
                MyFilterToApply :   _FilterToApply.LotCreation,
                MyCurrentStatut :   [_StatutDetail.DACValidee]
            },

            //Prepare le filtre sur les type de demandes sur lesquels l'action est applicable
            ClearCollect(ccValidForTypeDemande,Distinct( Filter( _TypeDemandeConfigTable,Self.Action in Actions),Type));

            Reset(inpNumLot_M);
            Reset(dteDirReaffFinConsul_M);
            UpdateIf(ccDemandes_V2,
                        true,
                        { RecordSelected: Statut_x0020_Detail in MyCurrentStatut}
            ); // Prepare la selection par defaut
            Select(btnGridClearSelect_M);
            UpdateContext({
                vcShowDirReaffFinConsul :   false,  // Reset step visibility (default hidden until selection or lot creation)
                vcCurrentProcess :          MyProcess,
                vcCurrentWizardStep :      1,
                vcApplyFilter :             MyFilterToApply
            });
        )
      OnUnavailable: |-
        =// ## Informe l'utilisateur si l'action en masse n'est pas autorisée pour la sélection courante
        If(vcCurrentProcess <> Self.Action,
            Notify(_txtMessage.ProcessOnGoing,NotificationType.Warning ,2000),
            Notify(_txtMessage.SelectionProcessNoEligibleItem & Concat(Self.SourceStatuses,Value," | ") ,NotificationType.Warning ,2000)
        );
      SourceStatuses: =[_StatutDetail.DACValidee]
      Text: =Self.Action
      Visible: |-
        =With({MyAction : Self.Action},
            /*
            [PATERN]Visibilité pilotée par une matrice de décision :
             - les statuts (définis dans App.Formulas) exposent les actions autorisées à ce niveau
             - chaque action définit elle-même les rôles autorisés
             → le bouton est visible uniquement si l’action est permise par le statut courant et accessible au rôle utilisateur
            */
            //MyAction in vcStatutConfig.Actions &&
            MyAction in vvUserRole.Actions
        )
      Width: =110
      X: =496
      Y: =476
