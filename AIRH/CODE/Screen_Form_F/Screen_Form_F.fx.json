                                    Visible: =ThisItem.IsSelected
                                    Width: =4
                              - btnDeleteUnlinkDoc_F:
                                  Control: ModernButton@1.0.0
                                  Properties:
                                    Align: =Align.Center
                                    FontWeight: =""
                                    Height: =19
                                    Icon: ="Delete"
                                    Layout: =ButtonLayout.IconOnly
                                    OnSelect: "=// Get all 'Demandes' currently linked to this document\r\nClearCollect(ccDemandesLieesUpDated_TEMP, \r\n    ThisItem.DemandesLiees // Existing\r\n);\r\n\r\n// Remove (unlink) this Demandes from the list of linked 'Demandes' for the current 'document'\r\nRemoveIf(ccDemandesLieesUpDated_TEMP,\r\n    Id = vcDemande.ID\r\n);\r\n\r\n// Update Document library for the current 'Document' with the updated list of linked 'Demandes'\r\nPatch(\r\n    AIRH_Documents,\r\n    LookUp(AIRH_Documents, ID = ThisItem.ID),\r\n    {\r\n        DemandesLiees: ccDemandesLieesUpDated_TEMP\r\n    }\r\n);\r\n\r\nRemoveIf(ccLinkedDocuments,ID = ThisItem.ID);\r\n\r\n//Free Up Memory    \r\nIf(Not(vvDebug),Clear(ccDemandesLieesUpDated_TEMP));\r\n    \r\nNotify(_txtMessage.DocUnLinkedToDemandeSuccess);\r\n\r\n"
                                    PaddingBottom: =5
                                    PaddingLeft: =12
                                    PaddingRight: =12
                                    PaddingTop: =5
                                    RadiusBottomLeft: =4
                                    RadiusBottomRight: =4
                                    RadiusTopLeft: =4
                                    RadiusTopRight: =4
                                    Text: ="Supprimer"
