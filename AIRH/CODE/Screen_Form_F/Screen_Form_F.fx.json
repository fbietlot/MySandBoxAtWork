                                    NextStatusData: =LookUp(_StatutConfigTable,StatusKey = Self.NextStatus)
                                    OnAlreadyRunning: =Notify(_txtMessage.ActionUnsupported,NotificationType.Error,2000)
                                    OnAvailable: "=// ## Logique métier de changement de statut\nWith(\n    // Défini via un With le prochain statut et le cas échéant l'actuel afin de rendre la suite du code générique\n    { \n        MyNextStatus_V2 :  Self.NextStatusData // Statut cible appliqué aux demandes après exécution\n    },\n    UpdateContext({vcDemande : \n        //# Applique le changement de statut à la demande traitée       \n        Patch(AIRH_Demandes,\n            vcDemande,\n            {\n                StatusKey:          MyNextStatus_V2.StatusKey,  \n                'Statut Detail':    MyNextStatus_V2.StatutDetail,\n                'Statut General':   MyNextStatus_V2.StatutGeneral\n            },\n            frmGeneralInfo_F.Updates\n        )\n    });\n\n    If(IsEmpty(Errors(AIRH_Demandes)),\n        Concurrent(\n            With(\n                {\n                    MyTypeDemande :     vcDemande.'Type de demande'.Value,\n                    //MyNbDemandes :      Value(CountRows(MyDemandeSPW));\n                    MySpw :             vcDemande.SPW,\n                    MyListeEmploiHtml :  \"<li>\" & vcDemande.'Numéro d''emploi' & \"</li>\",\n                    MyNumEmploi :       vcDemande.'Numéro d''emploi',\n                    MyRecipients :      _DACEmailList()\n                },\n                If(IsBlank(MyRecipients),\n                    // Aucune liste DFA configurée pour ce SPW ou pour la DAC\n                    Notify(_txtMessage.NoRecipient, NotificationType.Warning,5000),\n                    // Envoi standard\n                    Office365Outlook.SendEmailV2(\n                        // To  : distribution list\n                        MyRecipients,\n                        // Subject: notification métier                   \n                        _txtMessage.EmailSubjectPrefix \n                            &   MyTypeDemande & \" : Nouvelle(s) demande(s) envoyée(s) (\" & MySpw & \")\",   \n                        // Body: informations détaillées\n                        \"<p>Bonjour,</p> \" \n                                &    \"<p><i>[\" & MyTypeDemande & \"]: </i></p>\n                                <p>La/Les demande(s) suivante(s) ont été été transmise(s) via <b>\" & _AppName & \"</b></p>\"\n                            & \"<p><strong>\" & MySpw &\"</strong></p>\n                                <ul>\"\n                                & MyListeEmploiHtml\n                                &\"</ul>\" \n            \n                        & _txtMessage.EmailFooter \n                    );\n                )\n               \n            ),\n        \n            // # Trace chaque changement de statut dans l'historique\n            fxLogStatusHistory(\n                ShowColumns(vcDemande,ID,'Numéro d''emploi'),\n                MyNextStatus_V2.StatusKey,\n                vvUserRole.Key\n            )\n        );\n        ResetForm(frmGeneralInfo_F);\n        Navigate(Screen_Main_M);\n        \n        ,\n        Notify(_txtMessage.UpdateFailled,NotificationType.Error,5000)\n    );\n);\n\n\n"
