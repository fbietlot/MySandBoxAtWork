                                              ActionOwner:        {Key : "DFA",   Icon : "📝",       Text : "📝 DFA"},
                                              LinkedTypeDemande:  []
                                          },
                                          {
                                              StatusKey:          "DemandeBrouillon",
                                              StatutDetail:       "Brouillon de demande",
                                              StatutGeneral:      "Formulaire de demande",
                                              ProcessStepKey:     "InitDemande",
                                              ActionOwner:        {Key : "DFA",   Icon : "📝",       Text : "📝 DFA"},
                                              ActionRequired:     true,
                                              LinkedTypeDemande:  []
                                          }
                                      )
                                    Text: =Self.Action
                                    Visible: |-
                                      =With({MyAction : Self.Action},
                                          // [PATERN]Visibilité pilotée par une matrice de décision :
                                          // - les statuts (définis dans App.Formulas) exposent les actions autorisées à ce niveau
                                          // - chaque action définit elle-même les rôles autorisés
                                          // → le bouton est visible uniquement si l’action est permise par le statut courant et accessible au rôle utilisateur
                                          MyAction in vcStatutConfig.Actions
                                          && MyAction in vvUserRole.Actions
                                      )
                                    Width: =150
                                    X: =496
                                    Y: =476
                              - cmpActBtnPromAppro_F:
                                  Control: CanvasComponent
                                  ComponentName: cmpActionButton
                                  Properties:
                                    AccessibleLabel: ="Bouton " & Self.Action
                                    Action: =_ActionOnForm.PromAppro
                                    ActionState: |
                                      =If(!IsBlank(txtValidationAppro_F.Text) , // Rend l’action disponible uniquement lorsqu'il n'y a pas de remarque sur les chamsp obligatoires
                                          Self.StateValues.Unavailable,
                                          Self.StateValues.Available
                                      )
                                    BasePaletteColor: =RGBA(141, 229, 250, 1)
                                    EligibleItemsCount: =Blank()
                                    Height: =32
                                    Icon: ="DismissCircle"
                                    InteractionEnabled: =true
                                    NextStatus: =_StatusDetailKey.PromSignes
                                    NextStatusData: |-
                                      ={
                                          StatusKey:          "DemandeBrouillon",
                                          StatutDetail:       "Brouillon de demande",
                                          StatutGeneral:      "Formulaire de demande",
                                          ProcessStepKey:     "InitDemande",
                                          ActionOwner:        {Key : "DFA",   Icon : "📝",       Text : "📝 DFA"},
                                          ActionRequired:     true,
                                          LinkedTypeDemande:  []
                                      }
                                    OnAlreadyRunning: =Notify(_txtMessage.ActionUnsupported,NotificationType.Information,2000)
                                    OnAvailable: "=// ## Logique métier de changement de statut\nWith(\n    // Défini via un With le prochain statut et le cas échéant l'actuel afin de rendre la suite du code générique\n    { \n        MyNextStatus: {                                         // Statut cible appliqué aux demandes après exécution\n            Detail:   Self.NextStatus,\n            General:  LookUp(_StatutConfigTable,StatutDetail = Self.NextStatus).StatutGeneral\n        }\n    },\n    UpdateContext({vcDemande : \n        //# Applique le changement de statut à la demande traitée       \n        Patch(AIRH_Demandes,\n            vcDemande,\n            {\n                CommentPromGW:  Blank()\n            },\n            {\n                'Statut General': MyNextStatus.General,\n                'Statut Detail':  MyNextStatus.Detail\n            }\n        )\n    });\n\n    If(IsEmpty(Errors(AIRH_Demandes)),\n        Concurrent(\n            // # Notifie des changements de statut\n            With(\n                {\n                    MyTypeDemande :     vcDemande.'Type de demande'.Value,\n                    MySpw :             vcDemande.SPW,\n                    MyNumEmploi:        vcDemande.'Numéro d''emploi',\n                    MyRecipients :      _DFAEmailList(vcDemande.SPW)\n                },\n                If(IsBlank(MyRecipients),\n                    // Aucune liste DFA configurée pour ce SPW ou pour la DAC\n                    Notify(_txtMessage.NoRecipient, NotificationType.Warning,5000),\n                    // Envoi standard\n                    Office365Outlook.SendEmailV2(\n                        // To  : DFA distribution list\n                        MyRecipients,    \n                        // Subject: notification métier\n                        _txtMessage.EmailSubjectPrefix \n                            &   MyTypeDemande & \" : Proposition de désignation approuvée par GW\" & \" (\" & MyNumEmploi & \")\",\n                        // Body: informations détaillées\n                        \"<p>Bonjour,</p>\n                        <p>Dans le cadre de la <i>\" & MyTypeDemande & \"</i>, la proposition de désignation de l'agent (\"& vcDemande.CODICandidatRetenu.DisplayName &\") a été ✅approuvée par le GW via <b>\" & _AppName & \"</b> \" &\n                        \"pour le <b>\" & vcDemande.SPW & \"</b> (emploi <b>\" & vcDemande.'Numéro d''emploi' & \"</b>).\"\n                        & \"<p>\U0001F4CC Action requise : L'arrêté signé par l'autorité et l'accusé de réception à destination de l'agent se trouvent sur l'application. Merci de faire parvenir à l'agent un exemplaire de chaque document et de nous transmettre l'accusé de réception signé.</p>\n                        <p>D'avance merci.</p>\n                        <p>Bonne journée</p>\"\n                        & _txtMessage.EmailFooter \n                    )\n                )\n            ),\n            // # Trace chaque changement de statut dans l'historique\n            fxLogStatusHistory(\n                ShowColumns(vcDemande,ID,'Numéro d''emploi'),\n                MyNextStatus,\n                vvUserRole.Key\n            )\n        );\n        ResetForm(frmGeneralInfo_F);\n        Navigate(Screen_Main_M);\n        \n        ,\n        Notify(\"La demande n’a pas pu être mise à jour.\",NotificationType.Error,5000)\n    );\n);\n\n\n"
                                    OnUnavailable: |
                                      =// ## Informe l'utilisateur des informations requises
                                      Notify(_txtMessage.RequiredFields ,NotificationType.Warning ,2000);
                                    SourceStatuses: =[_StatutDetail.PromAuGWDG]
                                    SourceStatusesData: |-
                                      =Table(
                                          {
                                              StatusKey:          "DemandeNew",
                                              StatutDetail:       "Nouvelle demande",
                                              StatutGeneral:      "Formulaire de demande",
                                              ProcessStepKey:     "InitDemande",
                                              ActionOwner:        {Key : "DFA",   Icon : "📝",       Text : "📝 DFA"},
                                              LinkedTypeDemande:  []
                                          },
                                          {
                                              StatusKey:          "DemandeBrouillon",
                                              StatutDetail:       "Brouillon de demande",
                                              StatutGeneral:      "Formulaire de demande",
                                              ProcessStepKey:     "InitDemande",
                                              ActionOwner:        {Key : "DFA",   Icon : "📝",       Text : "📝 DFA"},
                                              ActionRequired:     true,
                                              LinkedTypeDemande:  []
                                          }
                                      )
                                    Text: =Self.Action
                                    Visible: |-
                                      =With({MyAction : Self.Action},
                                          // [PATERN]Visibilité pilotée par une matrice de décision :
                                          // - les statuts (définis dans App.Formulas) exposent les actions autorisées à ce niveau
                                          // - chaque action définit elle-même les rôles autorisés
                                          // → le bouton est visible uniquement si l’action est permise par le statut courant et accessible au rôle utilisateur
                                          MyAction in vcStatutConfig.Actions
                                          && MyAction in vvUserRole.Actions
                                      )
                                    Width: =150
                                    X: =496
                                    Y: =476
                  - ctnDocumentsLies_F:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        FillPortions: =0
