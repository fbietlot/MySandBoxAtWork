Screens:
  Screen_Form_F:
    Properties:
      OnVisible: |+
        =UpdateContext({
            vcShowDeleteConfirm: false ,
            vcShowDepartementLongText : false,
            vcshowStatusHitory:false
        });

        //# 2 GET LINKED DOCUMENT
        If(Not(IsBlank(vcDemande)),

        // Loads all documents linked to the current 'Demande' into a local collection for display/use in the app
        // Retrieves linked 'documents' via a Flow because the project architecture uses a document library with a multi-lookup to 'Demandes', and this avoids delegation limits when loading the full set
        UpdateContext({
            vcLinkedDocuments_Json: 
                AIRH_GetAllLinkedDocuments.Run(vcDemande.ID).response
        });
        // Parse json result into a proper collection
        ClearCollect(
            ccLinkedDocuments,
            ForAll(
                Table(ParseJSON(vcLinkedDocuments_Json)),
                {
                    ID: Value(Value.ID),
                    Nom: Text(Value.Nom),
                    DemandesLiees: ForAll(
                        Table(Value.DemandesLiees),
                        {
                            Id: Value(Value.Id),
                            Value: Text(Value.Value)
                        }
                    ),
                    CategorieDocument :
                        {
                            Id: Value(Value.CategorieDocument.Id),
                            Value: Text(Value.CategorieDocument.Value)
                        },

                    Url : Text(Value.Url),
                    Miniature : Text(Value.Miniature)
                }
            )
        );
        If(Not(vvDebug),
            UpdateContext({vcLinkedDocuments_Json:Blank()}));
            ,//else
            UpdateContext({
                vcDemande : Blank(),
                vcLinkedDocuments_Json:Blank()
            });
            Clear(ccLinkedDocuments)
        );

        //#3  SET UP SubwayNAV menu
        Reset(cbxSubNavRang_F);Reset(cbxSubNavStep_F);Reset(numSubNavMainStep_F);Reset(numSubNavStep_F);




    Children:
      - ctnMainContainer_F:
          Control: GroupContainer@1.5.0
          Variant: AutoLayout
          Properties:
            Fill: =RGBA(245, 245, 245, 1)
            Height: =Parent.Height
            LayoutAlignItems: =LayoutAlignItems.Stretch
            LayoutDirection: =LayoutDirection.Vertical
            LayoutGap: =16
            PaddingBottom: =16
            PaddingLeft: =16
            PaddingRight: =16
            PaddingTop: =16
            Width: =Parent.Width
          Children:
            - ctnHeaderContainer_F:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  AlignInContainer: =AlignInContainer.SetByContainer
                  FillPortions: =0
                  Height: =75
                  LayoutAlignItems: =LayoutAlignItems.Center
                  LayoutDirection: =LayoutDirection.Horizontal
                Children:
                  - Header_F:
                      Control: Header@0.0.44
                      Properties:
                        Align: =Align.Center
                        Title: |-
                          =_AppName & " - " & "Détails de la demande - Statut : " & vcDemande.'Statut Detail'  & " (" & vcDemande.'Statut General' & ")"
            - ctnSubWayNavConfig_DEBUG:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  FillPortions: =0
                  Height: =30
                  LayoutAlignItems: =LayoutAlignItems.Center
                  LayoutDirection: =LayoutDirection.Horizontal
                  LayoutMinHeight: =30
                  LayoutMinWidth: =16
                  PaddingBottom: =8
                  PaddingLeft: =8
                  PaddingRight: =8
                  PaddingTop: =8
                  Visible: =vvDebug
                Children:
                  - cbxSubNavStep_F:
                      Control: ModernCombobox@1.1.2
                      Properties:
                        DefaultSelectedItems: =vcStatutConfig
                        ItemDisplayText: '="(" & ThisItem.StatutGeneral & ")  " & ThisItem.StatutDetail '
                        Items: =_StatutConfigTable
                        SelectMultiple: =false
                        Size: =8
                        X: =422
                        Y: =40
                  - numSubNavStep_F:
                      Control: ModernNumberInput@1.1.2
                      Properties:
                        Default: =cbxSubNavStep_F.Selected.ProcessStep.StepOrder
                        Width: =91
                        X: =115
                        Y: =40
                  - numSubNavMainStep_F:
                      Control: ModernNumberInput@1.1.2
                      Properties:
                        Default: =Value( Left(cbxSubNavStep_F.Selected.ProcessStep.StepOrder,2))
                        Width: =91
                        X: =57
                        Y: =40
                  - cbxSubNavRang_F:
                      Control: ModernCombobox@1.1.2
                      Properties:
                        AccessibleLabel: =
                        DefaultSelectedItems: |-
                          ={Value : vcDemande.Rang}
                        ItemDisplayText: =ThisItem.Value
                        Items: =Distinct([@AIRH_Demandes],Rang)
                        LayoutMinHeight: =16
                        LayoutMinWidth: =16
                        SelectMultiple: =false
                  - numSubNavStep_F_V2:
                      Control: ModernNumberInput@1.1.2
                      Properties:
                        Default: =Value(cbxSubNavStep_F.Selected.ProcessStep.StepOrder)
                        Width: =91
                        X: =58
                        Y: =40
                  - numSubNavMainStep_F_V2:
                      Control: ModernNumberInput@1.1.2
                      Properties:
                        Default: =Value( cbxSubNavStep_F.Selected.ProcessStep.MainStepOrder)
                        Width: =91
                        X: =57
                        Y: =40
            - ctnBodyContainer_F:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  AlignInContainer: =AlignInContainer.SetByContainer
                  DropShadow: =DropShadow.None
                  LayoutAlignItems: =LayoutAlignItems.Stretch
                  LayoutDirection: =LayoutDirection.Horizontal
                  LayoutGap: =10
                  LayoutWrap: =true
                  PaddingBottom: =2
                  PaddingLeft: =2
                  PaddingRight: =2
                  PaddingTop: =2
                  RadiusBottomLeft: =0
                  RadiusBottomRight: =0
                  RadiusTopLeft: =0
                  RadiusTopRight: =0
                Children:
                  - ctnStatusSubWay_F_1:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        FillPortions: =0
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutMinHeight: =16
                        LayoutMinWidth: =16
                        Width: =200
                      Children:
                        - cmpProcessTimeline_F:
                            Control: CanvasComponent
                            ComponentName: cmpProcessTimeline
                            Properties:
                              CustomProcessStepStates: |-
                                ={
                                    Custom:
                                    {
                                        Key: "Custom",
                                        Label: "Complété",
                                        Icon: "VerifiedBrandSolid",
                                        Color: "#008000"
                                    }
                                }
                              Fill: =
                              ProcessSteps: "= With( {\n    // Regroupe les étapes détaillées par étape principale. \n    MyMainSteps :\n        AddColumns( \n            GroupBy(\n                _ProcessStepConfigTable,\n                MainStep,\n                ProcessSteps\n            ),\n            MainStepOrder, \n                First(ThisRecord.ProcessSteps).MainStepOrder       \n        ),\n    // Position actuelle de la demande dans le processus.\n    MyDemandeMainStepOrder : \n            numSubNavMainStep_F_V2.Value,\n    MyDemandeStepOrder : \n            numSubNavStep_F_V2.Value,\n\n    // Rang utilisé pour déterminer si l'étape de réaffectation doit être affichée comme ignorée.\n    MyDemandeRang : \n            cbxSubNavRang_F.Selected.Value\n    },\n\n    Ungroup(\n        ForAll(MyMainSteps  As MyMainStep,\n            Table(\n                {\n                    ProcessStepOrder:   MyMainStep.MainStepOrder,\n                    ProcessStepText:    MyMainStep.MainStep,\n                    ProcessStepState : \n                              Switch(\n                                true,\n\n                                // L'étape de réaffectation ne concerne\n                                // que les demandes de rang A4.\n                                MyMainStep.MainStep = _ProcessStepMain.DirReaff\n                                    && (!IsBlank(MyDemandeRang) && MyDemandeRang <> \"A4\"),\n                                    cmpProcessTimeline_F.ProcessStepStates.Skipped,\n\n                                MyMainStep.MainStepOrder = MyDemandeMainStepOrder,\n                                    cmpProcessTimeline_F.ProcessStepStates.Current,\n\n                                MyMainStep.MainStepOrder < MyDemandeMainStepOrder,\n                                    cmpProcessTimeline_F.ProcessStepStates.Completed,\n\n                                cmpProcessTimeline_F.ProcessStepStates.NotStarted\n                            )\n\n\n                },\n                ForAll(Filter(_ProcessStepConfigTable,MainStep = MyMainStep.MainStep) As MyStep, // Only Steps of the current Main step\n                    { \n                        ProcessStepOrder:        MyStep.StepOrder , \n                        ProcessStepText:      MyStep.Text,\n                        ProcessStepState : \n                                Switch(\n                                    true,\n\n                                    MyStep.StepOrder = MyDemandeStepOrder,\n                                        cmpProcessTimeline_F.ProcessStepStates.Current,\n\n                                    MyStep.StepOrder < MyDemandeStepOrder,\n                                        cmpProcessTimeline_F.ProcessStepStates.Completed,\n\n                                    cmpProcessTimeline_F.ProcessStepStates.NotStarted\n                                ),\n                        ParentProcessStepOrder : MyMainStep.MainStepOrder\n                        \n                    }\n                )\n            )\n    ),\n    Value\n    )\n)\n\n            "
                              ProcessStoppedAtStepOrder: =cbxSubNavStep_F.Selected.ProcessStep.ClosedFromStepOrder
                              Width: =200
                  - galStatusHistory:
                      Control: Gallery@2.15.0
                      Variant: BrowseLayout_Vertical_TwoTextVariant_ver5.0
                      Properties:
                        Default: =Last(Self.AllItems)
                        Items: =Filter( AIRH_Status_History,ID_Demande = vcDemande.ID)
                        TemplateSize: =40
                        Visible: =vcshowStatusHitory
                        Width: =240
                      Children:
                        - Title2:
                            Control: Label@2.5.1
                            Properties:
                              BorderColor: =RGBA(0, 0, 0, 1)
                              Color: =RGBA(50, 49, 48, 1)
                              FontWeight: =If(ThisItem.IsSelected, FontWeight.Semibold, FontWeight.Normal)
                              Height: =Self.Size * 1.8
                              OnSelect: =Select(Parent)
                              PaddingBottom: =0
                              PaddingLeft: =0
                              PaddingRight: =0
                              PaddingTop: =0
                              Size: =10
                              Text: =ThisItem.StatutGeneral
                              VerticalAlign: =VerticalAlign.Top
                              Width: =Parent.TemplateWidth - Self.X
                              X: =5
                        - Subtitle2:
                            Control: Label@2.5.1
                            Properties:
                              BorderColor: =RGBA(0, 0, 0, 1)
                              FontWeight: =If(ThisItem.IsSelected, FontWeight.Semibold, FontWeight.Normal)
                              Height: =Self.Size * 1.8
                              OnSelect: =Select(Parent)
                              PaddingBottom: =0
                              PaddingLeft: =0
                              PaddingRight: =0
                              PaddingTop: =0
                              Size: =10
                              Text: =ThisItem.StatutDetail
                              VerticalAlign: =VerticalAlign.Top
                              Width: =Title2.Width
                              X: =Title2.X
                              Y: =Title2.Y + Title2.Height
                        - Separator3:
                            Control: Rectangle@2.3.0
                            Properties:
                              Fill: =RGBA(255, 255, 255, 1)
                              Height: =8
                              OnSelect: =Select(Parent)
                              Width: =Parent.TemplateWidth
                              Y: =Parent.TemplateHeight - Self.Height
                        - Rectangle2:
                            Control: Rectangle@2.3.0
                            Properties:
                              Fill: =App.Theme.Colors.Darker30
                              Height: =Parent.TemplateHeight - Separator3.Height
                              OnSelect: =Select(Parent)
                              Visible: =ThisItem.IsSelected
                              Width: =4
                        - Title2_1:
                            Control: Label@2.5.1
                            Properties:
                              Align: =Align.Right
                              BorderColor: =RGBA(0, 0, 0, 1)
                              Color: =RGBA(50, 49, 48, 1)
                              FontWeight: =If(ThisItem.IsSelected, FontWeight.Semibold, FontWeight.Normal)
                              Height: =Self.Size * 1.8
                              OnSelect: =Select(Parent)
                              PaddingBottom: =0
                              PaddingLeft: =0
                              PaddingRight: =0
                              PaddingTop: =0
                              Size: =10
                              Text: =Text( ThisItem.Modifié,"dd/mm/yy")
                              VerticalAlign: =VerticalAlign.Top
                              Width: =Title2.Width
                              X: =5
                        - Title2_2:
                            Control: Label@2.5.1
                            Properties:
                              Align: =Align.Right
                              BorderColor: =RGBA(0, 0, 0, 1)
                              Color: =RGBA(50, 49, 48, 1)
                              FontWeight: =If(ThisItem.IsSelected, FontWeight.Semibold, FontWeight.Normal)
                              Height: =Self.Size * 1.8
                              OnSelect: =Select(Parent)
                              PaddingBottom: =0
                              PaddingLeft: =0
                              PaddingRight: =0
                              PaddingTop: =0
                              Size: =10
                              Text: =ThisItem.Acteur
                              VerticalAlign: =VerticalAlign.Top
                              Width: =Title2.Width
                              X: =5
                              Y: =18
                  - ctnFormsAndButton_F:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        AlignInContainer: =AlignInContainer.SetByContainer
                        DropShadow: =DropShadow.None
                        FillPortions: =7
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutGap: =5
                        LayoutMaxWidth: =Parent.Width
                        LayoutOverflowY: =LayoutOverflow.Scroll
                        PaddingBottom: =5
                        PaddingLeft: =5
                        PaddingRight: =15
                        PaddingTop: =5
                      Children:
                        - ctnForms_F:
                            Control: GroupContainer@1.5.0
                            Variant: AutoLayout
                            Properties:
                              DropShadow: =DropShadow.None
                              LayoutAlignItems: =LayoutAlignItems.Center
                              LayoutDirection: =LayoutDirection.Horizontal
                              LayoutMinHeight: =16
                              LayoutMinWidth: =16
                              PaddingBottom: =5
                              PaddingLeft: =5
                              PaddingRight: =5
                              PaddingTop: =5
                            Children:
                              - ctnFormGeneralInfo_F:
                                  Control: GroupContainer@1.5.0
                                  Variant: ManualLayout
                                  Properties:
                                    FillPortions: =7
                                    LayoutMinHeight: =16
                                    LayoutMinWidth: =16
                                  Children:
                                    - frmGeneralInfo_F:
                                        Control: Form@2.4.4
                                        Layout: Vertical
                                        Properties:
                                          DataSource: =AIRH_Demandes
                                          DefaultMode: =Coalesce(vcStatutConfig.Controls.FormGeneralInfo.Mode,FormMode.View)
                                          Height: =Parent.Height
                                          Item: =vcDemande
                                          NumberOfColumns: =2
                                          SnapToColumns: =false
                                          Visible: =Coalesce( vcStatutConfig.Controls.FormNextStep.Visible,true)
                                          Width: =Parent.Width
                                        Children:
                                          - crdHeadeGeneralInfo_F:
                                              Control: TypedDataCard@1.0.7
                                              Variant: BlankCard
                                              Properties:
                                                Height: =40
                                                Width: =Parent.Width
                                                X: =0
                                                Y: =0
                                              Children:
                                                - Text1:
                                                    Control: ModernText@1.0.0
                                                    Properties:
                                                      Align: =Align.Center
                                                      Color: =RGBA(15, 84, 140, 1)
                                                      Fill: =RGBA(255, 255, 255, 1)
                                                      FontWeight: =FontWeight.Bold
                                                      RadiusBottomLeft: =5
                                                      RadiusBottomRight: =5
                                                      RadiusTopLeft: =5
                                                      RadiusTopRight: =5
                                                      Text: ="Info sur la Demande"
                                                      Width: =Parent.Width - 2 * Self.X
                                                      X: =5
                                                - Text2:
                                                    Control: ModernText@1.0.0
                                                    Properties:
                                                      Align: =Align.Center
                                                      Color: =RGBA(255, 255, 255, 1)
                                                      Fill: =_Acteur.DFA.Color
                                                      FontWeight: =FontWeight.Bold
                                                      Height: =30
                                                      RadiusBottomLeft: =5
                                                      RadiusBottomRight: =Self.RadiusBottomLeft
                                                      RadiusTopLeft: =Self.RadiusBottomLeft
                                                      RadiusTopRight: =Self.RadiusBottomLeft
                                                      Size: =14
                                                      Text: =_Acteur.DFA.Text
                                                      Visible: =false
                                                      Width: =80
                                                      X: =Parent.Width - Self.Width - 20
                                                - lblDFormModeGenInfo_F_DEBUG:
                                                    Control: ModernText@1.0.0
                                                    Properties:
                                                      Height: =16
                                                      PaddingBottom: =0
                                                      PaddingLeft: =0
                                                      PaddingRight: =0
                                                      PaddingTop: =0
                                                      Size: =8
                                                      Text: |
                                                        =Switch(
                                                            frmGeneralInfo_F.Mode,
                                                            FormMode.New, "New",
                                                            FormMode.Edit, "Edit",
                                                            FormMode.View, "View",
                                                            "Unknown"
                                                        )
                                                      Visible: =vvDebug
                                                      X: =5
                                          - crdTitle_F:
                                              Control: TypedDataCard@1.0.7
                                              Variant: TextualEdit
                                              Properties:
                                                DataField: ="Title"
                                                Default: =ThisItem.Titre
                                                DisplayName: =DataSourceInfo([@AIRH_Demandes],DataSourceInfo.DisplayName,Titre)
                                                MaxLength: =DataSourceInfo([@AIRH_Demandes], DataSourceInfo.MaxLength, Titre)
                                                Required: =false
                                                Update: =drpTypeDemande_F.Selected.Value & "|" &   inpNumEmploi_F.Text & "|" &  dteDateDemandeCodi_F.SelectedDate
                                                Visible: =vvDebug // Champ technique uniquement affiché en mode Debug
                                                Width: =650
                                                X: =0
                                                Y: =5
                                              Children:
                                                - DataCardKey20:
                                                    Control: ModernText@1.0.0
                                                    MetadataKey: FieldName
                                                    Properties:
                                                      FontWeight: =FontWeight.Semibold
                                                      Height: =22
                                                      PaddingBottom: =0
                                                      PaddingLeft: =0
                                                      PaddingRight: =0
                                                      PaddingTop: =0
                                                      RadiusBottomLeft: =0
                                                      RadiusBottomRight: =0
                                                      RadiusTopLeft: =0
                                                      RadiusTopRight: =0
                                                      Size: =14
                                                      Text: =Parent.DisplayName
                                                      VerticalAlign: =VerticalAlign.Top
                                                      Width: =Parent.Width - 48
                                                      Wrap: =false
                                                      X: =24
                                                      Y: =10
                                                - DataCardValue20:
                                                    Control: ModernTextInput@1.1.2
                                                    MetadataKey: FieldValue
                                                    Properties:
                                                      AccessibleLabel: =Parent.DisplayName
                                                      Default: =Parent.Default
                                                      DisplayMode: =Parent.DisplayMode
                                                      FontWeight: =""
                                                      MaxLength: =-1
                                                      Placeholder: =""
                                                      Required: =Parent.Required
                                                      Size: =0
                                                      TriggerOutput: =TriggerOutput.FocusOut
                                                      ValidationState: =If(IsBlank(Parent.Error), "None", "Error")
                                                      Width: =Parent.Width - 48
                                                      X: =24
                                                      Y: =DataCardKey20.Y + DataCardKey20.Height + 4
                                          - crdNumEmploi_F:
                                              Control: TypedDataCard@1.0.7
                                              Variant: TextualEdit
                                              Properties:
                                                DataField: ="NumEmploi"
                                                Default: =ThisItem.'Numéro d''emploi'
                                                DisplayMode: =If(frmGeneralInfo_F.Mode = FormMode.New, Parent.DisplayMode,DisplayMode.View) // AS there are a lot of informationand processes derivtaed form the initial selection of this field we will only allow its modification at creation of the 'Demandes'
                                                DisplayName: =DataSourceInfo([@AIRH_Demandes],DataSourceInfo.DisplayName,'Numéro d''emploi')
                                                Height: =40
                                                MaxLength: =DataSourceInfo([@AIRH_Demandes], DataSourceInfo.MaxLength, 'Numéro d''emploi')
                                                Required: =false
                                                Update: =inpNumEmploi_F.Text
                                                Width: =Parent.Width / 2
                                                X: =5
                                                Y: =10
                                              Children:
                                                - DataCardKey22:
                                                    Control: ModernText@1.0.0
                                                    MetadataKey: FieldName
                                                    Properties:
                                                      FontWeight: =FontWeight.Semibold
                                                      Height: =txtTypeDemandeLabel_F.Height
                                                      PaddingBottom: =0
                                                      PaddingLeft: =0
                                                      PaddingRight: =0
                                                      PaddingTop: =0
                                                      RadiusBottomLeft: =0
                                                      RadiusBottomRight: =0
                                                      RadiusTopLeft: =0
                                                      RadiusTopRight: =0
                                                      Size: =txtTypeDemandeLabel_F.Size
                                                      Text: =Parent.DisplayName & " :"
                                                      VerticalAlign: =txtTypeDemandeLabel_F.VerticalAlign
                                                      Width: =txtTypeDemandeLabel_F.Width
                                                      Wrap: =false
                                                      X: =txtTypeDemandeLabel_F.X
                                                      Y: =txtTypeDemandeLabel_F.Y
                                                - inpNumEmploi_F:
                                                    Control: ModernTextInput@1.1.2
                                                    MetadataKey: FieldValue
                                                    Properties:
                                                      AccessibleLabel: =Parent.DisplayName
                                                      Color: =If(!IsBlank(Self.Text) && frmGeneralInfo_F.Mode =FormMode.New && IsBlank(vcPosteInformation.Numero_de_poste), Color.DarkRed,Blank())
                                                      Default: =cbxNumEmploi_F.Selected.Poste
                                                      DisplayMode: =Parent.DisplayMode
                                                      FontWeight: =""
                                                      Height: =drpTypeDemande_F.Height
                                                      MaxLength: =-1
                                                      OnChange: |-
                                                        =If(Len(Trim(Self.Text)) >= 3 ,
                                                            UpdateContext({
                                                                vcPosteInformation : LookUp('AIRH_Information postes',Numero_de_poste = Self.Text)
                                                            })
                                                        );

                                                        If(IsBlank(vcPosteInformation.Numero_de_poste),
                                                            Notify(_txtMessage.EmploiInconnu,NotificationType.Warning,1000)
                                                        )
                                                      Placeholder: =_txtMessage.PlaceHolderForField
                                                      Required: =Parent.Required
                                                      Size: '=13  '
                                                      TriggerOutput: =TriggerOutput.FocusOut
                                                      ValidationState: =If(IsBlank(Parent.Error), "None", "Error")
                                                      Width: =drpTypeDemande_F.Width
                                                      X: =drpTypeDemande_F.X
                                                      Y: =drpTypeDemande_F.Y
                                                - ErrorMessage22:
                                                    Control: ModernText@1.0.0
                                                    MetadataKey: ErrorMessage
                                                    Properties:
                                                      Height: =30
                                                      PaddingBottom: =0
                                                      PaddingLeft: =0
                                                      PaddingRight: =0
                                                      PaddingTop: =0
                                                      RadiusBottomLeft: =0
                                                      RadiusBottomRight: =0
                                                      RadiusTopLeft: =0
                                                      RadiusTopRight: =0
                                                      Size: =14
                                                      Text: =Parent.Error
                                                      VerticalAlign: =VerticalAlign.Top
                                                      Visible: =And(!IsBlank(Parent.Error), Parent.DisplayMode=DisplayMode.Edit)
                                                      Width: =Parent.Width - 48
                                                      X: =24
                                                      Y: =inpNumEmploi_F.Y + inpNumEmploi_F.Height
                                                - StarVisible22:
                                                    Control: ModernText@1.0.0
                                                    MetadataKey: FieldRequired
                                                    Properties:
                                                      Align: =Align.Center
                                                      Height: =30
                                                      PaddingBottom: =0
                                                      PaddingLeft: =0
                                                      PaddingRight: =0
                                                      PaddingTop: =0
                                                      RadiusBottomLeft: =0
                                                      RadiusBottomRight: =0
                                                      RadiusTopLeft: =0
                                                      RadiusTopRight: =0
                                                      Size: =14
                                                      Text: ="*"
                                                      VerticalAlign: =VerticalAlign.Top
                                                      Visible: =And(Parent.Required, Parent.DisplayMode=DisplayMode.Edit)
                                                      Width: =30
                                                      Y: =DataCardKey22.Y
                                                - cbxNumEmploi_F:
                                                    Control: ModernCombobox@1.1.2
                                                    Properties:
                                                      Appearance: =Appearance.FilledLighter
                                                      DefaultSelectedItems: |-
                                                        ={Poste : Parent.Default}
                                                      Height: =inpNumEmploi_F.Height
                                                      InputTextPlaceholder: |-
                                                        ="🔎 Rechercher un numéro d'emploi"
                                                      ItemDisplayText: =ThisItem.Poste
                                                      Items: |-
                                                        =ShowColumns(
                                                            Filter('AIRH_Information postes',DG = Coalesce(vvUserSPW, drpFilterSPW_M.Selected.SPW)) // Coalesce est utilisé pour le cas de la DFA
                                                            ,Numero_de_poste
                                                        )
                                                      OnChange: |-
                                                        =If(Len(Trim(Self.Selected.Poste)) >= 3 ,
                                                            UpdateContext({
                                                                vcPosteInformation : LookUp('AIRH_Information postes',Numero_de_poste = Self.Selected.Poste)
                                                            });
                                                            If(vcTypeDemandeConfig.Type = _TypeDemande.DemandeFF,
                                                                UpdateContext({ 
                                                                    vcDateDVLinked : Max(
                                                                        Filter(AIRH_Demandes,'Numéro d''emploi' = Self.Selected.Poste ,  DateDV_GW <> Blank())
                                                                    ,DateDV_GW)
                                                                });
                                                                If(!IsBlank(vcDateDVLinked),
                                                                    Notify("Date de demande de DV préalable récupérée (" & vcDateDVLinked & ")", NotificationType.Success,2000),
                                                                    Notify("Aucune demande de DV préalable dans la base de données pour ce numéro d'emploi", NotificationType.Success,2000)
                                                                )
                                                            )
                                                        );

                                                        If(IsBlank(vcPosteInformation.Numero_de_poste),
                                                            Notify(_txtMessage.EmploiInconnu,NotificationType.Warning,1000)
                                                        )
                                                      SelectMultiple: =false
                                                      Size: =inpNumEmploi_F.Size
                                                      Width: =inpNumEmploi_F.Width
                                                      X: =inpNumEmploi_F.X
                                                      Y: =inpNumEmploi_F.Y
                                          - crdTypeDemande_F:
                                              Control: TypedDataCard@1.0.7
                                              Variant: ComboBoxEdit
                                              Properties:
                                                DataField: ="TypeDemande"
                                                Default: |-
                                                  =If(frmGeneralInfo_F.Mode = FormMode.New,
                                                      LookUp(Choices([@AIRH_Demandes].'Type de demande'),Value = vcTypeDemandeConfig.Type),
                                                      ThisItem.'Type de demande'
                                                  )
                                                DisplayName: =DataSourceInfo([@AIRH_Demandes],DataSourceInfo.DisplayName,'Type de demande')
                                                Height: =40
                                                Required: =false
