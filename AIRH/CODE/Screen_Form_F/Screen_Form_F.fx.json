                                        )     

                                        & If(IsBlank( crdRaisonDemande_F.Update),
                                                            "Le champ [" & crdRaisonDemande_F.DisplayName &"] est obligatoire" & Char(10) ) 
                                        & If(crdDateRaison_F.Visible && IsBlank( crdDateRaison_F.Update),   
