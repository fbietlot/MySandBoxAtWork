- ctnProcessSendGW_M:
    Control: GroupContainer@1.5.0
    Variant: AutoLayout
    Properties:
      Height: =Parent.Height
      LayoutAlignItems: =LayoutAlignItems.Stretch
      LayoutDirection: =LayoutDirection.Vertical
      PaddingBottom: =8
      PaddingLeft: =8
      PaddingRight: =8
      PaddingTop: =8
      Visible: =vcCurrentProcess = _ActionOnList.SendNoteGW
      Width: =Parent.Width
      X: =(Parent.Width - Self.Width ) /2
    Children:
      - Text5_7:
          Control: ModernText@1.0.0
          Properties:
            Align: =Align.Center
            Color: =App.Theme.Colors.Darker10
            FontWeight: =FontWeight.Bold
            LayoutMinHeight: =16
            LayoutMinWidth: =16
            Size: =16
            Text: |-
              ="Processus : Envoi de la note au GW"
            Underline: =true
            Width: =220
      - ctnSendGWSelect_M:
          Control: GroupContainer@1.5.0
          Variant: AutoLayout
          Properties:
            AlignInContainer: =AlignInContainer.SetByContainer
            BorderStyle: =BorderStyle.None
            FillPortions: =0
            Height: =50
            LayoutAlignItems: =LayoutAlignItems.Center
            LayoutDirection: =LayoutDirection.Horizontal
            PaddingBottom: =8
            PaddingLeft: =8
            PaddingRight: =8
            PaddingTop: =8
            Width: =414
            Y: =40
          Children:
            - numSendGW_Select_M:
                Control: ModernNumberInput@1.1.2
                Properties:
                  Default: =1
                  DisplayMode: =DisplayMode.View
                  LayoutMinHeight: =16
                  LayoutMinWidth: =16
                  Width: =0
            - lblSendGWSelect_M:
                Control: ModernText@1.0.0
                Properties:
                  BorderColor: =App.Theme.Colors.Darker10
                  BorderStyle: =BorderStyle.Solid
                  BorderThickness: =0
                  Color: =If(vcCurrentWizardStep= numSendGW_Select_M.Value ,  App.Theme.Colors.Darker10, Color.Silver)
                  FontWeight: =FontWeight.Bold
                  LayoutMinHeight: =16
                  LayoutMinWidth: =16
                  PaddingBottom: =3
                  PaddingTop: =3
                  Size: =14
                  Text: |-
                    =With({MyStepNumber : numSendGW_Select_M.Value},
                        Switch(MyStepNumber,
                            1,_Emoji._1,
                            2,_Emoji._2,
                            3,_Emoji._3,
                            4,_Emoji._4,
                            5,_Emoji._5,
                            6,_Emoji._6
                        )
                        & If(vcCurrentWizardStep > MyStepNumber , "✅","")  
                        & " Sélectionner les demandes"
                    )
                  Width: =Parent.Width - Parent.PaddingLeft - Parent.PaddingRight - btnSendGWSelectAll_M.Width
            - btnSendGWSelectAll_M:
                Control: ModernButton@1.0.0
                Properties:
                  Align: =Align.Center
                  FontWeight: =FontWeight.Bold
                  Height: =24
                  Italic: =true
                  Layout: =ButtonLayout.TextOnly
                  OnSelect: |-
                    =UpdateContext({vcDemandesEvent:"SetSelection"&Text(Rand())});
                    UpdateContext({
                        vcCurrentWizardStep: numSendGW_Select_M.Value + 1
                    });
                  PaddingBottom: =5
                  PaddingLeft: =5
                  PaddingRight: =12
                  PaddingTop: =5
                  RadiusBottomLeft: =4
                  RadiusBottomRight: =4
                  RadiusTopLeft: =4
                  RadiusTopRight: =4
                  Size: =12
                  Text: ="Tout Sélectionner"
                  VerticalAlign: =VerticalAlign.Middle
                  Width: =120
      - ctnSendGWDate_M:
          Control: GroupContainer@1.5.0
          Variant: AutoLayout
          Properties:
            AlignInContainer: =AlignInContainer.SetByContainer
            FillPortions: =0
            Height: =50
            LayoutAlignItems: =LayoutAlignItems.Center
            LayoutDirection: =LayoutDirection.Horizontal
            PaddingBottom: =8
            PaddingLeft: =8
            PaddingRight: =8
            PaddingTop: =8
            Width: =414
            Y: =40
          Children:
            - numSendGWDate_M:
                Control: ModernNumberInput@1.1.2
                Properties:
                  Default: =2
                  DisplayMode: =DisplayMode.View
                  LayoutMinHeight: =16
                  LayoutMinWidth: =16
                  Width: =0
            - lblSendGWDate_M:
                Control: ModernText@1.0.0
                Properties:
                  BorderColor: =App.Theme.Colors.Darker10
                  BorderStyle: =BorderStyle.Solid
                  BorderThickness: =0
                  Color: =If(vcCurrentWizardStep= numSendGWDate_M.Value ,  App.Theme.Colors.Darker10, Color.Silver)
                  FontWeight: =FontWeight.Bold
                  LayoutMinHeight: =16
                  LayoutMinWidth: =16
                  PaddingBottom: =3
                  PaddingTop: =3
                  Size: =14
                  Text: |+
                    =With({MyStepNumber : numSendGWDate_M.Value},
                        Switch(MyStepNumber,
                            1,_Emoji._1,
                            2,_Emoji._2,
                            3,_Emoji._3,
                            4,_Emoji._4,
                            5,_Emoji._5,
                            6,_Emoji._6
                        )
                        & If(vcCurrentWizardStep > MyStepNumber , "✅","")  
                        & " Date d'envoi GW"
                    )
                  Width: =Parent.Width - Parent.PaddingLeft - Parent.PaddingRight - inpNumLot_M.Width
            - dteSendGWDate_M:
                Control: ModernDatePicker@1.0.2
                Properties:
                  Format: =DatePickerFormat.Short
                  LayoutMinHeight: =16
                  LayoutMinWidth: =16
                  OnChange: |-
                    =If(!IsBlank( Self.SelectedDate), // Trigger step progression only after the required input is filled
                        UpdateContext({
                            vcCurrentWizardStep: numSendGWDate_M.Value + 1
                        })
                    )
                  Placeholder: ="Choisir une date"
                  Visible: =vcCurrentWizardStep >= numSendGWDate_M.Value
                  Width: =150
      - ctnSendGWSave_M:
          Control: GroupContainer@1.5.0
          Variant: AutoLayout
          Properties:
            AlignInContainer: =AlignInContainer.SetByContainer
            FillPortions: =0
            Height: =50
            LayoutAlignItems: =LayoutAlignItems.Center
            LayoutDirection: =LayoutDirection.Horizontal
            PaddingBottom: =8
            PaddingLeft: =8
            PaddingRight: =8
            PaddingTop: =8
            Width: =414
            Y: =40
          Children:
            - numSendGWSave_M:
                Control: ModernNumberInput@1.1.2
                Properties:
                  Default: =3
                  DisplayMode: =DisplayMode.View
                  LayoutMinHeight: =16
                  LayoutMinWidth: =16
                  Width: =0
            - btnSendGWSave_M:
                Control: ModernButton@1.0.0
                Properties:
                  Align: =Align.Left
                  Appearance: =If(vcCurrentWizardStep = numSendGWSave_M.Value ,    ButtonAppearance.Primary,ButtonAppearance.Outline)
                  Color: =If(vcCurrentWizardStep= numSendGWSave_M.Value ,  Color.White, Color.Gray)
                  DisplayMode: =If(vcCurrentWizardStep = numSendGWSave_M.Value ,DisplayMode.Edit, DisplayMode.Disabled)
                  FontWeight: =FontWeight.Bold
                  Layout: =ButtonLayout.TextOnly
                  OnSelect: "=With({\n        // Statut cible \n        //(à priori déclaré sur le bouton de lancement du processus)\n        MyNextStatusDetail : cmpActBtnSendGW.NextStatus, \n        // Statuts depuis lesquels le processus peut être exécuté \n        // (à priori déclaré sur le bouton de lancement du processus)\n        // (utilisés plus loin pour maintenir le filtre après traitement)\n        MyCurrentStatuses : cmpActBtnSendGW.SourceStatuses\n    },\n    With(\n        { \n            // Reconstitue l'objet statut complet attendu par le modèle de données à partir du statut détail\n            MyNextStatus:                                 \n                {                                     \n                    Detail:   MyNextStatusDetail,\n                    General:  LookUp(_StatutConfigTable,StatutDetail = MyNextStatusDetail).StatutGeneral\n                }\n        },\n        // # Applique à toutes les demandes sélectionnées\n        //      - le changement de statut  \n        //      - les champs d'entrée complémentaires\n        ForAll(dlstDemandes_M.SelectedItems,\n            Patch(AIRH_Demandes,\n                ShowColumns( ThisRecord,ID),\n                {\n                    'Statut General':   MyNextStatus.General,\n                    'Statut Detail':    MyNextStatus.Detail\n                },\n                {\n                    DateGWSend: dteSendGWDate_M.SelectedDate\n                }\n            )        \n        );\n    \n\n    Concurrent(\n        // # envoi de notification pour cette action\n        // Pas de notification \n        false\n        ,       \n        // # Trace chaque changement de statut dans l'historique\n        fxLogStatusHistory(\n            ShowColumns(dlstDemandes_M.SelectedItems,ID,NumEmploi),\n            MyNextStatus,\n            vvUserRole.Key\n        );\n    );\n\n        // Confirmation utilisateur du traitement réalisé\n        Notify(\n            CountRows(dlstDemandes_M.SelectedItems) & \" demande(s) a/ont été correctement envoyée(s) au GW\" ,\n            NotificationType.Success,2000\n        );     \n\n            // Recharge les demandes afin de refléter immédiatement les changements de statut dans l'interface\n        Select(BtnLoadDemandes_M);\n        // Marque le processus comme terminé \n        // et adapte le filtre afin d'afficher les demandes dans leur nouveau statut\n                UpdateContext({\n            vcCurrentWizardStep:       numSendGWSave_M.Value + 1 ,\n            vcCurrentProcessCompleted:  true,\n            \n            // Conservation du mécanisme _DynamicOnStatus : \n            // les demandes restent visibles après traitement,\n            // mais désormais dans leur statut cible\n            vcApplyFilterOnStatus:      Table([cmpActBtnSendGW.NextStatus] , MyCurrentStatuses)\n        }) \n                \n\n\n)\n);\n\n"
                  PaddingBottom: =5
                  PaddingLeft: =5
                  PaddingRight: =12
                  PaddingTop: =5
                  RadiusBottomLeft: =4
                  RadiusBottomRight: =4
                  RadiusTopLeft: =4
                  RadiusTopRight: =4
                  Size: =14
                  Text: |+
                    =With({MyStepNumber : numSendGWDate_M.Value},
                        Switch(MyStepNumber,
                            1,_Emoji._1,
                            2,_Emoji._2,
                            3,_Emoji._3,
                            4,_Emoji._4,
                            5,_Emoji._5,
                            6,_Emoji._6
                        )
                        & If(vcCurrentWizardStep > MyStepNumber , "✅","")  
                        &  " Envoyer la Note"
                    )
                  VerticalAlign: =VerticalAlign.Middle
                  Width: =Parent.Width - Parent.PaddingLeft - Parent.PaddingRight
      - Container7_8:
          Control: GroupContainer@1.5.0
          Variant: AutoLayout
          Properties:
            AlignInContainer: =AlignInContainer.SetByContainer
            FillPortions: =0
            Height: =50
            LayoutAlignItems: =LayoutAlignItems.Center
            LayoutDirection: =LayoutDirection.Horizontal
            PaddingBottom: =8
            PaddingLeft: =8
            PaddingRight: =8
            PaddingTop: =8
            Width: =414
            Y: =40
          Children:
            - btnSendGWCancel_M:
                Control: ModernButton@1.0.0
                Properties:
                  Align: =Align.Left
                  FontWeight: =FontWeight.Bold
                  Layout: =ButtonLayout.TextOnly
                  OnSelect: |-
                    =Select(btnGridClearSelect_M); // Reset de la selection
                    UpdateContext({
                        vcCurrentProcess:       Blank(),
                        vcCurrentWizardStep:   Blank(),
                        vcApplyFilter :         Blank()
                    });
                  PaddingBottom: =5
                  PaddingLeft: =5
                  PaddingRight: =12
                  PaddingTop: =5
                  RadiusBottomLeft: =4
                  RadiusBottomRight: =4
                  RadiusTopLeft: =4
                  RadiusTopRight: =4
                  Size: =14
                  Text: =If(vcCurrentWizardStep = 4, "Terminer","Annuler")
                  VerticalAlign: =VerticalAlign.Middle
                  Width: =Parent.Width - Parent.PaddingLeft - Parent.PaddingRight
