- ctnProcessSendGW_M:
    Control: GroupContainer@1.5.0
    Variant: AutoLayout
    Properties:
      Height: =Parent.Height
      LayoutAlignItems: =LayoutAlignItems.Stretch
      LayoutDirection: =LayoutDirection.Vertical
      PaddingBottom: =8
      PaddingLeft: =8
      PaddingRight: =8
      PaddingTop: =8
      Visible: =vcCurrentProcess = _ActionOnList.SendNoteGW
      Width: =Parent.Width
      X: =(Parent.Width - Self.Width ) /2
    Children:
      - Text5_7:
          Control: ModernText@1.0.0
          Properties:
            Align: =Align.Center
            Color: =App.Theme.Colors.Darker10
            FontWeight: =FontWeight.Bold
            LayoutMinHeight: =16
            LayoutMinWidth: =16
            Size: =16
            Text: |-
              ="Processus : Envoi de la note au GW"
            Underline: =true
            Width: =220
      - ctnSendGWSelect_M:
          Control: GroupContainer@1.5.0
          Variant: AutoLayout
          Properties:
            AlignInContainer: =AlignInContainer.SetByContainer
            BorderStyle: =BorderStyle.None
            FillPortions: =0
            Height: =50
            LayoutAlignItems: =LayoutAlignItems.Center
            LayoutDirection: =LayoutDirection.Horizontal
            PaddingBottom: =8
            PaddingLeft: =8
            PaddingRight: =8
            PaddingTop: =8
            Width: =414
            Y: =40
          Children:
            - numSendGW_Select_M:
                Control: ModernNumberInput@1.1.2
                Properties:
                  Default: =1
                  DisplayMode: =DisplayMode.View
                  LayoutMinHeight: =16
                  LayoutMinWidth: =16
                  Width: =0
            - lblSendGWSelect_M:
                Control: ModernText@1.0.0
                Properties:
                  BorderColor: =App.Theme.Colors.Darker10
                  BorderStyle: =BorderStyle.Solid
                  BorderThickness: =0
                  Color: =If(vcWizardStep= numSendGW_Select_M.Value ,  App.Theme.Colors.Darker10, Color.Silver)
                  FontWeight: =FontWeight.Bold
                  LayoutMinHeight: =16
                  LayoutMinWidth: =16
                  PaddingBottom: =3
                  PaddingTop: =3
                  Size: =14
                  Text: |-
                    =With({MyStepNumber : numSendGW_Select_M.Value},
                        Switch(MyStepNumber,
                            1,_Emoji._1,
                            2,_Emoji._2,
                            3,_Emoji._3,
                            4,_Emoji._4,
                            5,_Emoji._5,
                            6,_Emoji._6
                        )
                        & If(vcWizardStep > MyStepNumber , "✅","")  
                        & " Sélectionner les demandes"
                    )
                  Width: =Parent.Width - Parent.PaddingLeft - Parent.PaddingRight - btnSendGWSelectAll_M.Width
            - btnSendGWSelectAll_M:
                Control: ModernButton@1.0.0
                Properties:
                  Align: =Align.Center
                  FontWeight: =FontWeight.Bold
                  Height: =24
                  Italic: =true
                  Layout: =ButtonLayout.TextOnly
                  OnSelect: |-
                    =UpdateContext({vcDemandesEvent:"SetSelection"&Text(Rand())});
                    UpdateContext({
                        vcWizardStep: numSendGW_Select_M.Value + 1
                    });
                  PaddingBottom: =5
                  PaddingLeft: =5
                  PaddingRight: =12
                  PaddingTop: =5
                  RadiusBottomLeft: =4
                  RadiusBottomRight: =4
                  RadiusTopLeft: =4
                  RadiusTopRight: =4
                  Size: =12
                  Text: ="Tout Sélectionner"
                  VerticalAlign: =VerticalAlign.Middle
                  Width: =120
      - ctnSendGWDate_M:
          Control: GroupContainer@1.5.0
          Variant: AutoLayout
          Properties:
            AlignInContainer: =AlignInContainer.SetByContainer
            FillPortions: =0
            Height: =50
            LayoutAlignItems: =LayoutAlignItems.Center
            LayoutDirection: =LayoutDirection.Horizontal
            PaddingBottom: =8
            PaddingLeft: =8
            PaddingRight: =8
            PaddingTop: =8
            Width: =414
            Y: =40
          Children:
            - numSendGWDate_M:
                Control: ModernNumberInput@1.1.2
                Properties:
                  Default: =2
                  DisplayMode: =DisplayMode.View
                  LayoutMinHeight: =16
                  LayoutMinWidth: =16
                  Width: =0
            - lblSendGWDate_M:
                Control: ModernText@1.0.0
                Properties:
                  BorderColor: =App.Theme.Colors.Darker10
                  BorderStyle: =BorderStyle.Solid
                  BorderThickness: =0
                  Color: =If(vcWizardStep= numSendGWDate_M.Value ,  App.Theme.Colors.Darker10, Color.Silver)
                  FontWeight: =FontWeight.Bold
                  LayoutMinHeight: =16
                  LayoutMinWidth: =16
                  PaddingBottom: =3
                  PaddingTop: =3
                  Size: =14
                  Text: |+
                    =With({MyStepNumber : numSendGWDate_M.Value},
                        Switch(MyStepNumber,
                            1,_Emoji._1,
                            2,_Emoji._2,
                            3,_Emoji._3,
                            4,_Emoji._4,
                            5,_Emoji._5,
                            6,_Emoji._6
                        )
                        & If(vcWizardStep > MyStepNumber , "✅","")  
                        & " Date d'envoi GW"
                    )
                  Width: =Parent.Width - Parent.PaddingLeft - Parent.PaddingRight - inpNumLot_M.Width
            - dteSendGWDate_M:
                Control: ModernDatePicker@1.0.2
                Properties:
                  Format: =DatePickerFormat.Short
                  LayoutMinHeight: =16
                  LayoutMinWidth: =16
                  OnChange: |-
                    =If(!IsBlank( Self.SelectedDate), // Trigger step progression only after the required input is filled
                        UpdateContext({
                            vcWizardStep: numSendGWDate_M.Value + 1
                        })
                    )
                  Placeholder: ="Choisir une date"
                  Visible: =vcWizardStep >= numSendGWDate_M.Value
                  Width: =150
      - ctnSendGWSave_M:
          Control: GroupContainer@1.5.0
          Variant: AutoLayout
          Properties:
            AlignInContainer: =AlignInContainer.SetByContainer
            FillPortions: =0
            Height: =50
            LayoutAlignItems: =LayoutAlignItems.Center
            LayoutDirection: =LayoutDirection.Horizontal
            PaddingBottom: =8
            PaddingLeft: =8
            PaddingRight: =8
            PaddingTop: =8
            Width: =414
            Y: =40
          Children:
            - numSendGWSave_M:
                Control: ModernNumberInput@1.1.2
                Properties:
                  Default: =3
                  DisplayMode: =DisplayMode.View
                  LayoutMinHeight: =16
                  LayoutMinWidth: =16
                  Width: =0
            - btnSendGWSave_M:
                Control: ModernButton@1.0.0
                Properties:
                  Align: =Align.Left
                  Appearance: =If(vcWizardStep = numSendGWSave_M.Value ,    ButtonAppearance.Primary,ButtonAppearance.Outline)
                  Color: =If(vcWizardStep= numSendGWSave_M.Value ,  Color.White, Color.Gray)
                  DisplayMode: =If(vcWizardStep = numSendGWSave_M.Value ,DisplayMode.Edit, DisplayMode.Disabled)
                  FontWeight: =FontWeight.Bold
                  Layout: =ButtonLayout.TextOnly
                  OnSelect: |+
                    =With({
                            // Statut cible 
                            //(à priori déclaré sur le bouton de lancement du processus)
                            MyNextStatus_V2:    cmpActBtnSendGW.NextStatusData,
                            // Statuts depuis lesquels le processus peut être exécuté 
                            // (à priori déclaré sur le bouton de lancement du processus)
                            // (utilisés plus loin pour maintenir le filtre après traitement)
                            MyCurrentStatuses_V2:   cmpActBtnSendGW.SourceStatusesData
                        },

                        // # Applique à toutes les demandes sélectionnées
                        //      - le changement de statut  
                        //      - les champs d'entrée complémentaires
                        ForAll(dlstDemandes_M.SelectedItems,
                            Patch(AIRH_Demandes,
                                ShowColumns( ThisRecord,ID),
                                {
                                    StatusKey:          MyNextStatus_V2.StatusKey,
                                    'Statut Detail':    MyNextStatus_V2.StatutDetail,
                                    'Statut General':   MyNextStatus_V2.StatutGeneral
                                },
                                {
                                    DateGWSend: dteSendGWDate_M.SelectedDate
                                }
                            )        
                        );

                        Concurrent(
                            // # envoi de notification pour cette action
                            // Pas de notification 
                            false
                            ,       
                            // # Trace chaque changement de statut dans l'historique
                            fxLogStatusHistory(
                                ShowColumns(dlstDemandes_M.SelectedItems,ID,NumEmploi),
                                MyNextStatus_V2.StatusKey,
                                vvUserRole.Key
                            );
                        );

                        // Confirmation utilisateur du traitement réalisé
                        Notify(
                            CountRows(dlstDemandes_M.SelectedItems) & " demande(s) a/ont été correctement envoyée(s) au GW" ,
                            NotificationType.Success,2000
                        );     

                        // Recharge les demandes afin de refléter immédiatement les changements de statut dans l'interface
                        Select(BtnLoadDemandes_M);

                        // Marque le processus comme terminé 
                        // et adapte le filtre afin d'afficher les demandes dans leur nouveau statut
                        UpdateContext({
                            vcWizardStep:       numSendGWSave_M.Value + 1 ,
                            vcWizardCompleted:  true,
                            // Conservation du mécanisme _DynamicOnStatus : 
                            // les demandes restent visibles après traitement,  mais désormais dans leur statut cible
                            vcApplyFilterOnStatus_V2:      Table({StatusKey : MyNextStatus_V2.StatusKey} , MyCurrentStatuses_V2.StatusKey)
                        })
                    )

                  PaddingBottom: =5
                  PaddingLeft: =5
                  PaddingRight: =12
                  PaddingTop: =5
                  RadiusBottomLeft: =4
                  RadiusBottomRight: =4
                  RadiusTopLeft: =4
                  RadiusTopRight: =4
                  Size: =14
                  Text: |+
                    =With({MyStepNumber : numSendGWSave_M.Value},
                        Switch(MyStepNumber,
                            1,_Emoji._1,
                            2,_Emoji._2,
                            3,_Emoji._3,
                            4,_Emoji._4,
                            5,_Emoji._5,
                            6,_Emoji._6
                        )
                        & If(vcWizardStep > MyStepNumber , "✅","")  
                        &  " Envoyer la Note"
                    )
                  VerticalAlign: =VerticalAlign.Middle
                  Width: =Parent.Width - Parent.PaddingLeft - Parent.PaddingRight
      - Container7_8:
          Control: GroupContainer@1.5.0
          Variant: AutoLayout
          Properties:
            AlignInContainer: =AlignInContainer.SetByContainer
            FillPortions: =0
            Height: =50
            LayoutAlignItems: =LayoutAlignItems.Center
            LayoutDirection: =LayoutDirection.Horizontal
            PaddingBottom: =8
            PaddingLeft: =8
            PaddingRight: =8
            PaddingTop: =8
            Width: =414
            Y: =40
          Children:
            - btnSendGWCancel_M:
                Control: ModernButton@1.0.0
                Properties:
                  Align: =Align.Left
                  FontWeight: =FontWeight.Bold
                  Layout: =ButtonLayout.TextOnly
                  OnSelect: |-
                    =Select(btnGridClearSelect_M); // Reset de la selection
                    UpdateContext({
                        vcCurrentProcess:       Blank(),
                        vcWizardStep:   Blank(),
                        vcApplyFilter :         Blank()
                    });
                  PaddingBottom: =5
                  PaddingLeft: =5
                  PaddingRight: =12
                  PaddingTop: =5
                  RadiusBottomLeft: =4
                  RadiusBottomRight: =4
                  RadiusTopLeft: =4
                  RadiusTopRight: =4
                  Size: =14
                  Text: =If(vcWizardStep = 4, "Terminer","Annuler")
                  VerticalAlign: =VerticalAlign.Middle
                  Width: =Parent.Width - Parent.PaddingLeft - Parent.PaddingRight
