                                  ComponentName: cmpActionButton
                                  Properties:
                                    AccessibleLabel: ="Afficher les critères de filtres"
                                    Action: =_ActionOnList.Archive
                                    ActionState: |
                                      =If(vcCurrentProcess = Blank(),
                                          Self.StateValues.Available,
                                          If(
                                              vcCurrentProcess = Self.Action , 
