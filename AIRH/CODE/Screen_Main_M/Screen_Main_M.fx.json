                                    - Text5_6:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          BorderColor: =App.Theme.Colors.Darker10
                                          BorderStyle: =BorderStyle.Solid
                                          BorderThickness: =0
                                          Color: =If(vcWizardStep = 2 ,  App.Theme.Colors.Darker10, Color.Silver)
                                          FontWeight: =FontWeight.Bold
                                          LayoutMinHeight: =16
                                          LayoutMinWidth: =16
                                          PaddingBottom: =3
                                          PaddingTop: =3
                                          Size: =14
                                          Text: =_Emoji._2 & If(vcWizardStep > 2 , "✅","")  & " Définir Numéro de Lot"
                                          Width: =Parent.Width - Parent.PaddingLeft - Parent.PaddingRight - inpNumLot_M.Width
                                    - inpNumLot_M:
                                        Control: ModernTextInput@1.1.2
                                        Properties:
                                          LayoutMinHeight: =16
                                          LayoutMinWidth: =16
                                          OnChange: |-
                                            =If(!IsBlank( Self.Text), // Trigger step progression only after the required input is filled
                                                UpdateContext({
                                                    vcWizardStep:  // Set next step depending on whether the A4-dependent step is applicable (visible or skipped)
                                                        If(ctnCreateLotDirReaffFinConsult_M.Visible,3, 4) 
                                                })
                                            )
                                          Placeholder: ="20**/**"
                                          TriggerOutput: =TriggerOutput.Delayed
                                          Visible: =vcWizardStep >= 2
                                          Width: =steCreateLotDirReaffFinConsult_M.Width
                              - ctnCreateLotDirReaffFinConsult_M:
                                  Control: GroupContainer@1.5.0
                                  Variant: AutoLayout
                                  Properties:
                                    AlignInContainer: =AlignInContainer.SetByContainer
                                    FillPortions: =0
                                    Height: =50
                                    LayoutAlignItems: =LayoutAlignItems.Center
                                    LayoutDirection: =LayoutDirection.Horizontal
                                    PaddingBottom: =8
                                    PaddingLeft: =8
                                    PaddingRight: =8
                                    PaddingTop: =8
                                    Visible: |+
                                      =// Keep the step visible if current selection contains at least one A4
                                      // OR after lot creation if the lot included at least one A4
                                      Or( 
                                          !IsEmpty(
                                              Filter(dlstDemandes_M.SelectedItems, Rang = "A4")
                                          ),
                                          vcShowDirReaffFinConsul
                                      )
                                    Width: =414
                                    Y: =40
                                  Children:
                                    - lblCreateLotDirReaffFinConsult_M:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          BorderColor: =App.Theme.Colors.Darker10
                                          BorderStyle: =BorderStyle.Solid
                                          BorderThickness: =0
                                          Color: =If(vcWizardStep= 3 ,  App.Theme.Colors.Darker10, Color.Silver)
                                          FontWeight: =FontWeight.Bold
                                          LayoutMinHeight: =16
                                          LayoutMinWidth: =16
                                          PaddingBottom: =3
                                          PaddingTop: =3
                                          Size: =14
                                          Text: =_Emoji._3 & If(vcWizardStep > 3 , "✅","")  & "Date Fin consultation"
                                          Width: =Parent.Width - Parent.PaddingLeft - Parent.PaddingRight - inpNumLot_M.Width
                                    - steCreateLotDirReaffFinConsult_M:
                                        Control: ModernDatePicker@1.0.2
                                        Properties:
                                          Format: =DatePickerFormat.Short
                                          LayoutMinHeight: =16
                                          LayoutMinWidth: =16
                                          OnChange: |-
                                            =If(!IsBlank( Self.SelectedDate), // Trigger step progression only after the required input is filled
                                                UpdateContext({
                                                    vcWizardStep: 4
                                                })
                                            )
                                          Placeholder: ="Choisir une date"
                                          Visible: =vcWizardStep >= 3
                                          Width: =150
                              - ctnCreateLotSave_M:
                                  Control: GroupContainer@1.5.0
                                  Variant: AutoLayout
                                  Properties:
                                    AlignInContainer: =AlignInContainer.SetByContainer
                                    FillPortions: =0
                                    Height: =50
                                    LayoutAlignItems: =LayoutAlignItems.Center
                                    LayoutDirection: =LayoutDirection.Horizontal
                                    PaddingBottom: =8
                                    PaddingLeft: =8
                                    PaddingRight: =8
                                    PaddingTop: =8
                                    Width: =414
                                    Y: =40
                                  Children:
                                    - btnCreateLotSave_M:
                                        Control: ModernButton@1.0.0
                                        Properties:
                                          Align: =Align.Left
                                          Appearance: =If(vcWizardStep = 4 ,    ButtonAppearance.Primary,ButtonAppearance.Outline)
                                          Color: =If(vcWizardStep= 4 ,  Color.White, Color.Gray)
                                          DisplayMode: =If(vcWizardStep = 4 ,DisplayMode.Edit, DisplayMode.Disabled)
                                          FontWeight: =FontWeight.Bold
                                          Layout: =ButtonLayout.TextOnly
                                          OnSelect: |-
                                            =With({
                                                    // Statut cible 
                                                    //(à priori déclaré sur le bouton de lancement du processus)
                                                    // MyNextStatus_V2:        cmpActBtnSendDAC_M.NextStatusData;
                                                    // Statuts depuis lesquels le processus peut être exécuté 
                                                    // (à priori déclaré sur le bouton de lancement du processus)
                                                    // (utilisés plus loin pour maintenir le filtre après traitement)
                                                    MyCurrentStatuses_V2 :  cmpActBtnSendDAC_M.SourceStatusesData
                                                },

                                                // Create the 'Lot' by updating each selected 'Demande' to its next status (A4 path vs standard path)
                                                ForAll(dlstDemandes_M.SelectedItems As MyDemande,
                                                    With({
                                                        MyDemandeNextStatus:        
                                                            If(MyDemande.Rang = "A4",
                                                            LookUp(_StatutConfigTable,StatusKey = _StatusDetailKey.DirReaffConsult),
                                                            LookUp(_StatutConfigTable,StatusKey = _StatusDetailKey.DACDVEnPrevision)
                                                            )
                                                        },

                                                        Patch(AIRH_Demandes,
                                                            ShowColumns( MyDemande,ID),
                                                            {
                                                                StatusKey:          MyDemandeNextStatus.StatusKey,
                                                                'Statut Detail':    MyDemandeNextStatus.StatutDetail,
                                                                'Statut General':   MyDemandeNextStatus.StatutGeneral
                                                            },
                                                            If(MyDemande.Rang = "A4",
                                                                // Route 'Demande' through the director reaffectation consultation (with end date)
                                                                {
                                                                    Lot : inpNumLot_M.Text,
                                                                    DateDirReaffFinConsult: steCreateLotDirReaffFinConsult_M.SelectedDate
                                                                },
                                                                // Route 'Demande' through the standard DV validation pipeline
                                                                {
                                                                    Lot : inpNumLot_M.Text
                                                                }
                                                            )
                                                        );

                                                       // # Trace chaque changement de statut dans l'historique
                                                        fxLogStatusHistory(
                                                            ShowColumns(vcDemande,ID,'Numéro d''emploi'),
                                                            MyDemandeNextStatus.StatusKey,
                                                            vvUserRole.Key
                                                        )
                                                    )
                                                );

                                                // Preserve the A4-dependent step after selection reset (lot content drives visibility, not current selection)
                                                If(ctnCreateLotDirReaffFinConsult_M.Visible,
                                                    UpdateContext({vcShowDirReaffFinConsul: true})
                                                );

                                                // Notify stakeholders that the DV 'Lot' has been created (recipients grouped by SPW)
                                                With(
                                                    {
                                                        MyDistributionList : // Build the mailing list by expanding each distinct SPW to its distribution emails
                                                            Concat(
                                                                ForAll(
                                                                    Distinct(dlstDemandes_M.SelectedItems,SPW),
                                                                    { 
                                                                        SPW : ThisRecord.Value,
                                                                        Emails :  _DFAEmailList(ThisRecord.Value)
                                                                    }
                                                                ),
                                                                Emails,
                                                                ";"
                                                        )
                                                    },
                                                    Office365Outlook.SendEmailV2(
                                                        MyDistributionList,                     // To: SPW distribution lists for impacted 'Demandes'
                                                        _txtMessage.EmailSubjectPrefix &   "Constitution Lot DV",     // Subject: DV lot creation notification
                                                        // Body: include the A4 consultation deadline only when applicable        
                                                        "Bonjour,<br><br>" &
                                                        If(! vcShowDirReaffFinConsul,
                                                            "Les emplois pour la demande DV ont été sélectionnés. 
                                                            <br>Toute nouvelle demande fera partie d'une demande de DV future
                                                            " 
                                                            ,//@Else
                                                            "Les emplois pour la demande DV ont été sélectionnés. 
                                                            <br>Toute nouvelle demande fera partie d'une demande de DV future. 
                                                            <br>Les Directeurs en instance de réaffectation peuvent postuler jusqu'au " & steCreateLotDirReaffFinConsult_M.SelectedDate &". 
                                                            <br>Merci de revenir vers nous après cette date. 
                                                            "
                                                        )                
                                                        & _txtMessage.EmailFooter 
                                                    );
                                                );

                                                // Reload UI data to reflect the newly created 'Lot'
                                                Select(BtnLoadDemandes_M);

                                                // Marque le processus comme terminé 
                                                // et adapte le filtre afin d'afficher les demandes dans leur nouveau statut
                                                UpdateContext({
                                                    vcWizardStep:        5 ,
                                                    vcWizardCompleted:  true,
                                                    // Conservation du mécanisme _DynamicOnStatus : 
                                                    // les demandes restent visibles après traitement,
                                                    // mais désormais dans leur statut cible
                                                    vcApplyFilterOnStatus_V2:      Table({StatusKey :_StatusDetailKey.DirReaffConsult},{StatusKey :_StatusDetailKey.DACDVEnPrevision} , MyCurrentStatuses_V2.StatusKey)
                                                }) 
                                            );
                                          PaddingBottom: =5
                                          PaddingLeft: =5
                                          PaddingRight: =12
                                          PaddingTop: =5
                                          RadiusBottomLeft: =4
                                          RadiusBottomRight: =4
                                          RadiusTopLeft: =4
                                          RadiusTopRight: =4
                                          Size: =14
                                          Text: =If(ctnCreateLotDirReaffFinConsult_M.Visible, _Emoji._4 , _Emoji._5) & If(vcWizardStep > 4 , "✅","")  & " Constituer le lot"
                                          VerticalAlign: =VerticalAlign.Middle
                                          Width: =Parent.Width - Parent.PaddingLeft - Parent.PaddingRight
                              - ctnCreateLotCancel_M:
                                  Control: GroupContainer@1.5.0
                                  Variant: AutoLayout
                                  Properties:
                                    AlignInContainer: =AlignInContainer.SetByContainer
                                    FillPortions: =0
                                    Height: =50
                                    LayoutAlignItems: =LayoutAlignItems.Center
                                    LayoutDirection: =LayoutDirection.Horizontal
                                    PaddingBottom: =8
                                    PaddingLeft: =8
                                    PaddingRight: =8
                                    PaddingTop: =8
                                    Width: =414
                                    Y: =40
                                  Children:
                                    - btnLotCancel_M:
                                        Control: ModernButton@1.0.0
                                        Properties:
                                          Align: =Align.Left
                                          FontWeight: =FontWeight.Bold
                                          Layout: =ButtonLayout.TextOnly
                                          OnSelect: =Select(btnGenericExitProcess_M);
                                          PaddingBottom: =5
                                          PaddingLeft: =5
                                          PaddingRight: =12
                                          PaddingTop: =5
                                          RadiusBottomLeft: =4
                                          RadiusBottomRight: =4
                                          RadiusTopLeft: =4
                                          RadiusTopRight: =4
                                          Size: =14
                                          Text: =If(vcWizardStep = 5, "Terminer","Annuler")
                                          VerticalAlign: =VerticalAlign.Middle
                                          Width: =Parent.Width - Parent.PaddingLeft - Parent.PaddingRight
                        - ctnProcessSendDAC_M:
                            Control: GroupContainer@1.5.0
                            Variant: AutoLayout
                            Properties:
                              Height: =Parent.Height
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutDirection: =LayoutDirection.Vertical
                              PaddingBottom: =8
                              PaddingLeft: =8
                              PaddingRight: =8
                              PaddingTop: =8
                              Visible: =vcCurrentProcess in [ _ActionOnList.SendDAC ]
                              Width: =Parent.Width
                              X: =(Parent.Width - Self.Width ) /2
                            Children:
                              - Text5_13:
                                  Control: ModernText@1.0.0
                                  Properties:
                                    Align: =Align.Center
                                    Color: =App.Theme.Colors.Darker10
                                    FontWeight: =FontWeight.Bold
                                    LayoutMinHeight: =16
                                    LayoutMinWidth: =16
                                    Size: =16
                                    Text: |-
                                      ="Processus : Envoi à la DAC"
                                    Underline: =true
                                    Width: =220
                              - ctnSendDACSelect_M:
                                  Control: GroupContainer@1.5.0
                                  Variant: AutoLayout
                                  Properties:
                                    AlignInContainer: =AlignInContainer.SetByContainer
                                    BorderStyle: =BorderStyle.None
                                    FillPortions: =0
                                    Height: =50
                                    LayoutAlignItems: =LayoutAlignItems.Center
                                    LayoutDirection: =LayoutDirection.Horizontal
                                    PaddingBottom: =8
                                    PaddingLeft: =8
                                    PaddingRight: =8
                                    PaddingTop: =8
                                    Width: =414
                                    Y: =40
                                  Children:
                                    - numSendDACSelect_M:
                                        Control: ModernNumberInput@1.1.2
                                        Properties:
                                          Default: =1
                                          DisplayMode: =DisplayMode.View
                                          LayoutMinHeight: =16
                                          LayoutMinWidth: =16
                                          Width: =0
                                    - lblSendDACSelect_M:
                                        Control: ModernText@1.0.0
                                        Properties:
                                          BorderColor: =App.Theme.Colors.Darker10
                                          BorderStyle: =BorderStyle.Solid
                                          BorderThickness: =0
                                          Color: =If(vcWizardStep= numSendDACSelect_M.Value ,  App.Theme.Colors.Darker10, Color.Silver)
                                          FontWeight: =FontWeight.Bold
                                          LayoutMinHeight: =16
                                          LayoutMinWidth: =16
                                          PaddingBottom: =3
                                          PaddingTop: =3
                                          Size: =14
                                          Text: |-
                                            =With({MyStepNumber : numSendDACSelect_M.Value},
                                                Switch(MyStepNumber,
                                                    1,_Emoji._1,
                                                    2,_Emoji._2,
                                                    3,_Emoji._3,
                                                    4,_Emoji._4,
                                                    5,_Emoji._5,
                                                    6,_Emoji._6
                                                )
                                                & If(vcWizardStep > MyStepNumber , "✅","")  
                                                & " Sélectionner les demandes"
                                            )
                                          Width: =Parent.Width - Parent.PaddingLeft - Parent.PaddingRight - SendDACSelectAll_M.Width
                                    - SendDACSelectAll_M:
                                        Control: ModernButton@1.0.0
                                        Properties:
                                          Align: =Align.Center
                                          DisplayMode: =If(vcWizardStep = numSendDACSelect_M.Value ,DisplayMode.Edit, DisplayMode.Disabled)
                                          FontWeight: =FontWeight.Bold
                                          Height: =24
                                          Italic: =true
                                          Layout: =ButtonLayout.TextOnly
                                          OnSelect: |-
                                            =UpdateContext({vcDemandesEvent:"SetSelection"&Text(Rand())});
                                            UpdateContext({
                                                vcWizardStep: numSendDACSelect_M.Value + 1 
                                            });
                                          PaddingBottom: =5
                                          PaddingLeft: =5
                                          PaddingRight: =12
                                          PaddingTop: =5
                                          RadiusBottomLeft: =4
                                          RadiusBottomRight: =4
                                          RadiusTopLeft: =4
                                          RadiusTopRight: =4
                                          Size: =12
                                          Text: ="Tout Sélectionner"
                                          VerticalAlign: =VerticalAlign.Middle
                                          Width: =120
                              - ctnSendDACSave_M:
                                  Control: GroupContainer@1.5.0
                                  Variant: AutoLayout
                                  Properties:
                                    AlignInContainer: =AlignInContainer.SetByContainer
                                    FillPortions: =0
                                    Height: =50
                                    LayoutAlignItems: =LayoutAlignItems.Center
                                    LayoutDirection: =LayoutDirection.Horizontal
                                    PaddingBottom: =8
                                    PaddingLeft: =8
                                    PaddingRight: =8
                                    PaddingTop: =8
                                    Width: =414
                                    Y: =40
                                  Children:
                                    - numSendDACSave_M:
                                        Control: ModernNumberInput@1.1.2
                                        Properties:
                                          Default: =2
                                          DisplayMode: =DisplayMode.View
                                          LayoutMinHeight: =16
                                          LayoutMinWidth: =16
                                          Width: =0
                                    - btnSendDACSave_M:
                                        Control: ModernButton@1.0.0
                                        Properties:
                                          Align: =Align.Left
                                          Appearance: =If(vcWizardStep = numSendDACSave_M.Value ,    ButtonAppearance.Primary,ButtonAppearance.Outline)
                                          Color: =If(vcWizardStep= numSendDACSave_M.Value ,  Color.White, Color.Gray)
                                          DisplayMode: =If(vcWizardStep = numSendDACSave_M.Value ,DisplayMode.Edit, DisplayMode.Disabled)
                                          FontWeight: =FontWeight.Bold
                                          Layout: =ButtonLayout.TextOnly
                                          OnSelect: |-
                                            =With({
                                                    // Statut cible 
                                                    //(à priori déclaré sur le bouton de lancement du processus)
                                                    MyNextStatus_V2:        cmpActBtnSendDAC_M.NextStatusData,
                                                    // Statuts depuis lesquels le processus peut être exécuté 
                                                    // (à priori déclaré sur le bouton de lancement du processus)
                                                    // (utilisés plus loin pour maintenir le filtre après traitement)
                                                    MyCurrentStatuses_V2 :  cmpActBtnSendDAC_M.SourceStatusesData
                                                },
                                                // # Applique le changement de statut à toutes les demandes sélectionnées
                                                ForAll(dlstDemandes_M.SelectedItems,
                                                    Patch(AIRH_Demandes,
                                                        ShowColumns( ThisRecord,ID),
                                                        {
                                                            StatusKey:          MyNextStatus_V2.StatusKey,
                                                            'Statut Detail':    MyNextStatus_V2.StatutDetail,
                                                            'Statut General':   MyNextStatus_V2.StatutGeneral
                                                        }
                                                    )        
                                                );

                                                Concurrent(
                                                    // # envoi de notification pour cette action
                                                    ForAll(
                                                        Distinct(dlstDemandes_M.SelectedItems,SPW) As MyCurrentSpw,
                                                        With({MyDemandeSPW : Filter(dlstDemandes_M.SelectedItems,SPW = MyCurrentSpw.Value)},
                                                            With(
                                                                {
                                                                    MyTypeDemande :     First(MyDemandeSPW).TypeDemandeValue,
                                                                    MyNbDemandes :      Value(CountRows(MyDemandeSPW)),
                                                                    MySpw :             MyCurrentSpw.Value,
                                                                    MyListeEmploiHtml : Concat( MyDemandeSPW,"<li>" & NumEmploi & "</li>" & Char(10) ),
                                                                    MyRecipients :      _DACEmailList()
                                                                },
                                                                If(IsBlank(MyRecipients),
                                                                    // Aucune liste DFA configurée pour ce SPW ou pour la DAC
                                                                    Notify(_txtMessage.NoRecipient, NotificationType.Warning,5000),
                                                                    // Envoi standard
                                                                    Office365Outlook.SendEmailV2(
                                                                        // To  : distribution list
                                                                        MyRecipients,
                                                                        // Subject: notification métier                   
                                                                        _txtMessage.EmailSubjectPrefix 
                                                                            &   MyTypeDemande & " : Nouvelle(s) demande(s) envoyée(s) (" & MySpw & ")",    
                                                                        // Body: informations détaillées
                                                                        "<p>Bonjour,</p> " 
                                                                                &    "<p><i>[" & MyTypeDemande & "]: </i></p>
                                                                                <p>Les demandes suivantes ont été été transmise via <b>" & _AppName & "</b></p>"
                                                                            & "<p><strong>" & MySpw &"</strong></p>
                                                                                <ul>"
                                                                                & MyListeEmploiHtml
                                                                                &"</ul>" 
                                                                        & _txtMessage.EmailFooter 
                                                                    );
                                                                )
                                                            )
                                                        )
                                                    );
                                                    ,       
                                                    // # Trace chaque changement de statut dans l'historique
                                                    fxLogStatusHistory(
                                                        ShowColumns(dlstDemandes_M.SelectedItems,ID,NumEmploi),
                                                        MyNextStatus_V2.StatusKey,
                                                        vvUserRole.Key
                                                    );
                                                );

                                                // Confirmation utilisateur du traitement réalisé
                                                Notify(
                                                    CountRows(dlstDemandes_M.SelectedItems) & " demande(s) a/ont été correctement envoyée(s) à la DAC" ,
                                                    NotificationType.Success,2000
                                                );  

                                                // Recharge les demandes afin de refléter immédiatement les changements de statut dans l'interface
                                                Select(BtnLoadDemandes_M);

                                                // Marque le processus comme terminé 
                                                // et adapte le filtre afin d'afficher les demandes dans leur nouveau statut
                                                UpdateContext({
                                                    vcWizardStep:        numSendDACSave_M.Value + 1 ,
                                                    vcWizardCompleted:  true,
                                                    // Conservation du mécanisme _DynamicOnStatus : 
                                                    // les demandes restent visibles après traitement,
                                                    // mais désormais dans leur statut cible
                                                    vcApplyFilterOnStatus_V2:      Table({StatusKey : MyNextStatus_V2.StatusKey} , MyCurrentStatuses_V2.StatusKey)
                                                }) 
                                            );
                                          PaddingBottom: =5
                                          PaddingLeft: =5
                                          PaddingRight: =12
                                          PaddingTop: =5
                                          RadiusBottomLeft: =4
                                          RadiusBottomRight: =4
                                          RadiusTopLeft: =4
                                          RadiusTopRight: =4
                                          Size: =14
                                          Text: |
                                            =With({MyStepNumber : numSendDACSave_M.Value},
                                                Switch(MyStepNumber,
                                                    1,_Emoji._1,
                                                    2,_Emoji._2,
                                                    3,_Emoji._3,
                                                    4,_Emoji._4,
                                                    5,_Emoji._5,
                                                    6,_Emoji._6
                                                )
                                                & If(vcWizardStep > MyStepNumber , "✅","")  
                                                &    " Envoyer"
                                            )
                                          VerticalAlign: =VerticalAlign.Middle
                                          Width: =Parent.Width - Parent.PaddingLeft - Parent.PaddingRight
                              - ctnSendDACExit_M:
                                  Control: GroupContainer@1.5.0
                                  Variant: AutoLayout
                                  Properties:
                                    AlignInContainer: =AlignInContainer.SetByContainer
                                    FillPortions: =0
                                    Height: =50
                                    LayoutAlignItems: =LayoutAlignItems.Center
                                    LayoutDirection: =LayoutDirection.Horizontal
                                    PaddingBottom: =8
                                    PaddingLeft: =8
                                    PaddingRight: =8
                                    PaddingTop: =8
                                    Width: =414
                                    Y: =40
                                  Children:
                                    - numSendDACExit_M:
                                        Control: ModernNumberInput@1.1.2
                                        Properties:
                                          Default: =3
                                          DisplayMode: =DisplayMode.View
                                          LayoutMinHeight: =16
                                          LayoutMinWidth: =16
                                          Width: =0
                                    - btnSendDACExit_M:
                                        Control: ModernButton@1.0.0
                                        Properties:
                                          Align: =Align.Left
                                          FontWeight: =FontWeight.Bold
                                          Layout: =ButtonLayout.TextOnly
                                          OnSelect: =Select(btnGenericExitProcess_M)
                                          PaddingBottom: =5
                                          PaddingLeft: =5
                                          PaddingRight: =12
                                          PaddingTop: =5
                                          RadiusBottomLeft: =4
                                          RadiusBottomRight: =4
                                          RadiusTopLeft: =4
                                          RadiusTopRight: =4
                                          Size: =14
                                          Text: =If(vcWizardStep = numSendDACExit_M.Value, "Terminer","Annuler")
                                          VerticalAlign: =VerticalAlign.Middle
                                          Width: =Parent.Width - Parent.PaddingLeft - Parent.PaddingRight
                  - ctnDemandeList_M:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        Height: =140
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutGap: =4
                        LayoutWrap: =true
                        X: =40
                        Y: =40
                      Children:
                        - tabTypeDemande_M:
                            Control: ModernTabList@1.0.2
                            Properties:
                              Appearance: =TabListAppearance.SubtleCircular
                              Default: |-
                                ={Type : _TypeDemande.All}
                              Height: =30
                              ItemDisplayText: =ThisItem.Icon &  ThisItem.Type
                              Items: |-
                                =Table(  {Type: _TypeDemande.All}, If(IsBlank(vcCurrentProcess),  _TypeDemandeConfigTable,Filter(_TypeDemandeConfigTable, vcCurrentProcess in Actions)))
                              LayoutMinHeight: =16
                              LayoutMinWidth: =16
                              TabSize: =TabSize.Small
                              Width: =dlstDemandes_M.Width
                        - dlstDemandes_M:
                            Control: CodeComponent
                            ComponentName: cat_PowerCAT.FluentDetailsList
                            Properties:
                              AlternateRowColor: ="#F5F5F5"
                              CurrentSortColumn: =vcDemandesSortField
                              CurrentSortDirection: |-
                                =If(vcDemandesSortOrder,
                                    'PowerCAT.FluentDetailsList.CurrentSortDirection'.Ascending,
                                    'PowerCAT.FluentDetailsList.CurrentSortDirection'.Descending
                                )
                              Height: =Parent.Height - 40 - tabTypeDemande_M.Height
                              InputEvent: =vcDemandesEvent
                              Items: |+
                                =SortByColumns(
                                    Filter(
                                        Switch(vcApplyFilter ,
                                            _FilterToApply._DynamicOnStatus,
                                                Filter(
                                                    ccDemandes,
                                                    Statut_x0020_Detail in vcApplyFilterOnStatus
                                                ),
                                            _FilterToApply._DynamicOnStatus_V2,
                                                Filter(
                                                    ccDemandes,
                                                    StatusKey in vcApplyFilterOnStatus_V2
                                                ), 
                                            //default
                                                Filter(
                                                    ccDemandes,
                                                    And(
                                                        Or(drpFilterSPW_M.Selected.SPW = Blank() , SPW = Coalesce(vvUserSPW, drpFilterSPW_M.Selected.SPW)), // Coalesce est utilisé pour le cas de la DFA
                                                        Or(drpFilterStatus.Selected.Id = Blank(), Statut_x0020_Detail = drpFilterStatus.Selected.Value),
                                                        Or(IsBlank(txtFilterLot.Text), StartsWith(Lot, txtFilterLot.Text)),
                                                        Or(IsBlank(txtFilterRang.Text), StartsWith(Rang, txtFilterRang.Text)),
                                                        Or(!tglMesActions_M.Checked, StartsWith(ActionOwner, "⚡"))
                                                    )
                                                )
                                        ),
                                        If(IsEmpty( ccValidForTypeDemande ), true, TypeDemandeValue in ccValidForTypeDemande),
                                        If(tabTypeDemande_M.Selected.Type = _TypeDemande.All, true, TypeDemandeValue =  tabTypeDemande_M.Selected.Type)
                                    ),
                                    //"ActionOwner";SortOrder.Ascending; //[DEPRECATED] Les Demandes où une action est requise ets toujours en premier
                                    If(vcDefaultSort,"StatutSortOrder"),SortOrder.Descending,
                                    //Tri par défaut dans vcDemandesSortField : "Modified" et vcDemandesSortOrder : SortOrder.Descending
                                    vcDemandesSortField, 
                                    If(vcDemandesSortOrder,SortOrder.Ascending,SortOrder.Descending)
                                )
                              OnChange: |+
                                =//EventName	Output Event when OnChange is triggered. Possible values - Sort, CellAction, OnRowSelectionChange
                                //EventColumn	Output Event column field name used when CellAction is invoked
                                //EventRowKey	Output Event column that holds either the index of the row that the event was invoked on, or the Row Key if the RecordKey property is set.
                                //Notify(Self.EventName);;
                                /*
                                If(Self.EventName="CellAction";Notify("CellAction " & Self.EventColumn & " " & Self.EventRowKey));;
                                */

                                Switch(Self.EventName,
                                    "Sort",
                                        //SortEventColumn	The name of the column that triggered the Sort OnChange event
                                        //SortEventDirection	The direction of the sort that triggered the Sort OnChange event
                                        //UpdateContext({vcDefaultSort: false});
                                        UpdateContext({
                                            vcDefaultSort: false,
                                            vcDemandesSortField:   Self.SortEventColumn,
                                            vcDemandesSortOrder: If(Self.SortEventDirection='PowerCAT.FluentDetailsList.SortEventDirection'.Ascending,true,false)
                                        }),
                                    "CellAction",
                                        If( Self.EventColumn = "expand",
                                            With(
                                                {MyRow : LookUp(ccDemandes, ID = Value( Self.EventRowKey))},
                                                Patch(
                                                    ccDemandes,
                                                    MyRow,
                                                    { expand: !MyRow.expand }
                                                )
                                            )
                                        ),
                                    "OnRowSelectionChange",
                                        If(vcCurrentProcess = _ActionOnList.CODIDecision && vcWizardStep = numCODIdecisionSelectSingle_M.Value,
                                            UpdateContext({vcWizardStep : Max( numCODIdecisionSelectSingle_M.Value + 1,vcWizardStep)})
                                        );
                                        If(vcCurrentProcess in [_ActionOnList.GWDecision] && !IsBlank( radGWdecisionChoice_M.Selected.Value)
                                                && (_MuliSelectOnDemandes || _SingleSelectOnDemandes),
                                        UpdateContext({vcWizardStep : Max( 3,vcWizardStep)})
                                        );
                                        //Approche générique
                                        If(
                                            vcWizardStepAfterSelect  
                                                && (_MuliSelectOnDemandes || _SingleSelectOnDemandes),
                                            UpdateContext({vcWizardStep : Max(vcWizardStepAfterSelect,vcWizardStep)})
                                        );
                                )
                              OnSelect: |-
                                =// Navigue vers l’écran formulaire en chargeant la demande complète depuis la source 
                                // ainsi que les configurations associées basées sur la sélection utilisateur
                                With({ MyDemande :   dlstDemandes_M.Selected},
                                    Navigate(Screen_Form_F,
                                        Transition.Pop,
                                        {
                                            vcDemande:              LookUp(AIRH_Demandes,           ID = dlstDemandes_M.Selected.ID ), // MyDemande.ID générait une erreur de delegation (probable faux positif du compilateur)
                                            // Indique que l’écran est ouvert en mode édition afin d’adapter l’interface et les boutons disponibles
                                            // Remarque : le mode des formulaires est piloté dynamiquement via vcStatutConfig afin de respecter les règles métier liées au statut
                                            vcScreenIsReadOnly :    false,
                                            vcTypeDemandeConfig :   LookUp(_TypeDemandeConfigTable, Type =  MyDemande.TypeDemandeValue),
                                            vcStatutConfig :        LookUp(_StatutConfigTable,      StatusKey = MyDemande.StatusKey),            
                                            vcPosteInformation:     Blank()     
                                        }
                                    )
                                );
                              PageSize: =100
                              RaiseOnRowSelectionChangeEvent: =true
                              RecordKey: ="ID"
                              RecordSelected: |-
                                ="RecordSelected"
                                //RecordSelected (optional) - The column name that contains a boolean value defining if a row is selected by default and when setting the InputEvent to contain SetSelection. See the section on Set Selection below.
                              SelectionType: |-
                                =/****************************
                                    Adapte le mode de sélection des demandes en fonction du processus et de l'étape actuellement en cours.
                                    - Certains processus nécessitent d'abord un choix initial (Approbation/refus/...) dans le panneau de processus 
                                        avant d'autoriser la sélection des demandes à traiter (Process Bulk).
                                      À l'inverse, une fois le processus terminé, la sélection n'a plus d'utilité.
                                    - Certains processus imposent un traitement individuel et limitent donc la sélection à une seule demande à la fois (Process Individuel).
                                    - D'autres processus débutent par une sélection multiple (par exemple pour l'ajout de documents en masse),
                                      puis imposent un traitement individuel lors d'une étape ultérieure (Approbation/designatoin/Refus...).
                                *****************************/
                                If(
                                    And(
                                        vcCurrentProcess in [_ActionOnList.CostraDecision, _ActionOnList.GWDecision,_ActionOnList.DirCandid] ,
                                        (vcWizardStep = 1 || vcWizardCompleted)
                                    ),
                                    'PowerCAT.FluentDetailsList.SelectionType'.None,
                                    If(
                                        Or(
                                            vcCurrentProcess = _ActionOnList.CostraDecision && radCOSTRAdecisionChoice_M.Selected.Value = _Decision.Refusée,
                                            vcCurrentProcess = _ActionOnList.CODIDecision && vcWizardStep >= numCODIdecisionSelectSingle_M.Value,
                                            vcCurrentProcess = _ActionOnList.GWDecision && vcWizardStep >= numGwDecisionChoice_M.Value 
                                        ),
                                        'PowerCAT.FluentDetailsList.SelectionType'.Single,
                                        'PowerCAT.FluentDetailsList.SelectionType'.Multiple
                                    )
                                )
