                      Children:
                        - radRole_M:
                            Control: ModernRadio@1.0.2
                            Properties:
                              Default: |-
                                =//Switch(vvUserRole.Key;_Acteur.DFA.Key; _Acteur.DFA;_Acteur.DAC.Key;_Acteur.DAC;Blank())
                                vvUserRole
                              Height: =26
                              ItemDisplayText: =ThisItem.Text
                              Items: =[_Acteur.DAC,_Acteur.DFA]
                              Layout: =OptionLayout.Horizontal
                              OnChange: |-
                                =// Builds the current table configuration by applying actor-based visibility rules to the default catalog
                                Set(vvUserRole , Self.Selected);
                                If(vvUserRole.Key = _Acteur.DFA.Key,Set(vvUserSPW, "SPWSG"));


                                Select(BtnLoadDemandes_M);
                              PaddingBottom: =0
                              PaddingLeft: =0
                              PaddingRight: =0
                              PaddingTop: =0
                              RadioSize: =10
                              Size: =12
                              Visible: =vvDebug
                              Width: =200
                              X: '=btnConfigView_M.X - Self.Width -5 '
                        - BtnLoadDemandes_M:
                            Control: ModernButton@1.0.0
                            Properties:
                              Align: =Align.Center
                              BasePaletteColor: =RGBA(246, 142, 104, 1)
                              FontWeight: =""
                              Height: =20
                              Icon: ="Library"
                              OnSelect: "=/*######### GRID DATA REFRESH CONTROLLER #######################################\nBouton technique centralisant le rechargement complet du FluentDetailList.\n\n    Son OnSelect est appelé depuis différents points de l'application afin de\n    garantir un comportement de rafraîchissement cohérent et d'éviter la duplication\n    de code :\n    • OnVisible de l'écran\n    • Après des opérations de masse (btnBulk...)\n    • À la fin de certains traitements métier (btnProcessDo...)\n    • En mode debug (ex. changement de rôle ou validation d'un scénario)\n\n    Lors d'un rafraîchissement :\n        • l'état de tri de la gille est initialisé \n        • Les données sont chargées depuis SharePoint dans une collection locale\n        • Les règles d'accès liées au rôle et au périmètre SPW sont appliquées\n        • Les métadonnées d'affichage sont pré-calculées\n        • La configuration des colonnes est adaptée au rôle courant\n        • Toute sélection active est réinitialisée\n\n    Le FluentDetailList travaille ensuite exclusivement sur les collections locales.\n    Les filtres, recherches et tris interactifs sont effectués dans la propriété\n    Items du contrôle sans réinterroger SharePoint, ce qui améliore les performances\n    et garantit un comportement cohérent de la grille.\n\n    Le contrôle FluentDetailList est un composant du Power Platform Creator Kit\n    https://learn.microsoft.com/en-us/power-platform/guidance/creator-kit/detailslist\n    Il est utilisé pour l'affichage d'une liste des \"Demandes\"\n###############################################################################*/\n\n/******** Initialisation de l'état de la grille ********************************\n    Les variables vcDemandes... sont nécessaires à la configuration du contrôle FluentDetailList\n    Définit l'état par défaut du FluentDetailList avant le chargement des données.\n    Le tri initial est appliqué sur la date de dernière modification afin de\n        présenter en priorité les demandes les plus récemment mises à jour.\n*******************************************************************************/\nUpdateContext({\n    vcDemandesSortField  : _DemandesFieldName.Modified,\n    vcDemandesSortOrder : false\n});\n\n/******** Précharge les demandes accessibles à l'utilisateur. *****************\n    La collection ccDemandes constitue la source de données principale du FluentDetailList.\n    Les règles de visibilité liées aux rôles et aux autorisations sont appliquées\n        dès le chargement afin de ne conserver que les demandes accessibles à l'utilisateur.\n    Les métadonnées utilisées par l'affichage sont également pré-calculées afin\n        d'éviter des traitements répétitifs lors des interactions avec la grille.\n    Remarques : \n        Les recherches, filtres et tris utilisateur sont ensuite effectués sur cette collection\n                locale via la propriété Items du FluentDetailList sans nouvel appel à SharePoint.\n*******************************************************************************/\nClearCollect(ccDemandes,\n    /*---- Logique de Construction de la source de données de la grille : ---------\n        • ShowColumns : sélection des colonnes utiles\n        • Filter : filtrage selon les droits de l'utilisateur\n        • AddColumns : préchargement des métadonnées de type et de statut\n        • AddColumns : enrichissement des données pour l'affichage\n        • DropColumns : nettoyage des colonnes temporaires\n    -------------------------------------------------------------------------*/\n    DropColumns(                    // Nettoie les métadonnées intermédiaires après enrichissement des demandes\n        AddColumns(                 // Construit les attributs d'affichage et d'interaction utilisés par la grille\n            AddColumns(             // Précharge temporairement les métadonnées liées au type et au statut pour éviter des recherches répétées lors de l'enrichissement\n                If(vcCurrentProcess <> _ActionOnList.Archive,\n                    Filter(             // Affiche uniquement les demandes actives accessibles à l'utilisateur selon son rôle et son périmètre SPW\n                        ShowColumns(    // Limite les données chargées aux colonnes utilisées par la grille\n                            AIRH_Demandes,\n                            // Les colonnes à afficher\n                            ID,Archive,'Type de demande',Lot,'Numéro d''emploi',\n                            'Code ES',SPW,'Département (Abréviation)',Département,Direction,Service,Rang,\n                            'Date de demande du CODI',\n                            'Statut General','Statut Detail',StatusKey,\n                            DateDirReaffFinConsult,\n                            Modifié,'Modifié par'\n                        ),\n                        // Les filtres à appliquer\n                        And( \n                            Archive = false,    // Seules les demandes actives sont affichées -  Exclut les demandes archivées\n                            Or(                 // Les demandes en brouillon sont masquées pour la DAC\n                                vvUserRole.Key <> _Acteur.DAC.Key, \n                                StatusKey <> _StatusDetailKey.DemandeBrouillon\n                            ), \n                            Or(                 // Le périmètre de consultation est limité au SPW de l'utilisateur, sauf pour la DAC\n                                vvUserRole.Key = _Acteur.DAC.Key,\n                                SPW = vvUserSPW\n                            )\n                        )\n                    ),\n                    Filter(             // Affiche uniquement les demandes actives accessibles à l'utilisateur selon son rôle et son périmètre SPW\n                        ShowColumns(    // Limite les données chargées aux colonnes utilisées par la grille\n                            AIRH_Demandes,\n                            // Les colonnes à afficher\n                            ID,Archive,'Type de demande',Lot,'Numéro d''emploi',\n                            'Code ES',SPW,'Département (Abréviation)',Département,Direction,Service,Rang,\n                            'Date de demande du CODI',\n                            'Statut General','Statut Detail',StatusKey,\n                            DateDirReaffFinConsult,\n                            Modifié,'Modifié par'\n                        ),\n                        // Les filtres à appliquer\n                        And( \n                            Archive = true,\n                            StartsWith( NumEmploi,txtArchiveEmploi_M.Text), \n                            Or(                 // Les demandes en brouillon sont masquées pour la DAC\n                                vvUserRole.Key <> _Acteur.DAC.Key, \n                                StatusKey <> _StatusDetailKey.DemandeBrouillon\n                            ), \n                            Or(                 // Le périmètre de consultation est limité au SPW de l'utilisateur, sauf pour la DAC\n                                vvUserRole.Key = _Acteur.DAC.Key,\n                                SPW = vvUserSPW\n                            )\n                        )\n                    ) \n                    \n                )As MyDemandesRawData,\n                // Les métadonnées à précharger\n                MyTypeInfo ,    // Précharge la configuration du type de demande\n                    LookUp(_TypeDemandeConfigTable, Type = MyDemandesRawData.TypeDemande.Value),\n                MyStatusInfo ,  // Précharge la configuration du statut de la demande\n                    LookUp(_StatutConfigTable,StatusKey = MyDemandesRawData.StatusKey)\n            ) As MyDemandes,\n            // Les attributs à ajouter\n            // • Attributs d'affichage du type de demande\n            TypeDemandeValue ,      // Libellé du type de demande\n                MyDemandes.TypeDemande.Value,\n            TypeDemandeIcon,        // Type de demande enrichi avec son indicateur visuel de couleur\n                MyDemandes.MyTypeInfo.Icon & MyDemandes.TypeDemande.Value,\n            TypeDemandeColor,       // Couleur associée au type de demande\n                MyDemandes.MyTypeInfo.ColorHex,\n            // • Attributs liés aux actions attendues\n            ActionOwner,            // Acteur responsable de la prochaine action avec indicateur d'action immédiate si requis\n                Switch(\n                    MyDemandes.MyStatusInfo.ActionOwner.Key, \n                    _Acteur.DAC.Key, If(vvUserRole.Key = _Acteur.DAC.Key && MyDemandes.MyStatusInfo.ActionRequired, \"⚡\") & _Acteur.DAC.Text, \n                    _Acteur.DFA.Key, If(vvUserRole.Key = _Acteur.DFA.Key && MyDemandes.MyStatusInfo.ActionRequired, \"⚡\") &_Acteur.DFA.Text, \n                    \"\"\n                ),\n            ActionOwnerColor,       // Couleur associée à l'acteur responsable\n                Switch(\n                    MyDemandes.MyStatusInfo.ActionOwner.Key, \n                    _Acteur.DAC.Key, _Acteur.DAC.ColorHex, \n                    _Acteur.DFA.Key, _Acteur.DFA.ColorHex, \n                    \"rgb(0, 0, 0)\"\n                ),\n            // • Attributs d'information\n            ModifiedBy,             // Nom du dernier utilisateur ayant modifié la demande\n                MyDemandes.Editor.DisplayName,\n            // • Attributs de suivi du processus\n            StatutSortOrder,        // Ordre de tri représentant la progression de la demande dans le processus\n                MyDemandes.MyStatusInfo.StatutGeneral_SortOrder & MyDemandes.MyStatusInfo.StatutDetail_SortOrder,\n            StatutProgressBar,      // Représentation visuelle de l'avancement de la demande dans le processus (▰▰▰▰▰▰▰✔)\n                MyDemandes.MyStatusInfo.StatutProgressBar,\n            StatutEcheance ,        // Échéance ou jalon métier associé à certains statuts\n                Switch(MyDemandes.Statut_x0020_Detail,\n                    _StatutDetail.DirReaffConsult,MyDemandes.DateDirReaffFinConsult,\n                    Blank()\n                ),\n            // • Attributs techniques FluentDetailList\n            RecordSelected  ,       // Permet de forcer la sélection d'une ligne dans le FluentDetailList (non sélectionnée par défaut)\n                false,\n            expand,                 // Permet d'afficher une demande sur plusieurs lignes dans le FluentDetailList (vue compacte par défaut)\n                false\n        ),\n        // Les colonnes à oublier\n        MyStatusInfo,MyTypeInfo,Editor,Archive,TypeDemande\n    )\n);\n\n\n/******** Construit la configuration du FluentDetailList adaptée au rôle courant. ************\n    Le catalogue de référence contient l'ensemble des colonnes disponibles ainsi que leurs propriétés d'affichage (v*sibilité, tri, largeur, comporteme*t...).\n    Seules les colonnes autorisées pour le rôle de l'utilisateur sont conservées.\n    Cette configuration sert ensuite de source unique pou* le rendu de la grille.\n********************************************************************************************/\nClearCollect(ccDetailsListColumnsConfig,\n    DropColumns(\n        Filter(\n            _tblDemandesFieldCatalog, \n            vvUserRole.Key in View\n        ),\n        View\n    )\n);\n\n/******** Reset selection ***************************************************************\n    Force la suppression de toute sélection résiduelle après le rechargement de la grille \n**************************************************************************************/\nSelect(btnGridClearSelect_M); "
                              PaddingBottom: =5
