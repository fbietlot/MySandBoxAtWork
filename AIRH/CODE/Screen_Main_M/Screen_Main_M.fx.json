                              - cmpActBtnNew_M:
                                  Control: CanvasComponent
                                  ComponentName: cmpActionButton
                                  Properties:
                                    AccessibleLabel: ="Bouton de création d'une nouvelle Demande"
                                    Action: =_ActionOnList.NewDemande
                                    ActionState: |+
                                      =If(vcCurrentProcess = Blank(),
                                          Self.StateValues.Available,
                                          If(
                                              vcCurrentProcess = Self.Action , 
                                              Self.StateValues.ProcessAlreadyRunning,
                                              Self.StateValues.AnotherProcessIsRunning
                                          )
                                      )

                                    BasePaletteColor: =
                                    EligibleItemsCount: =Blank()
                                    Height: =32
                                    Icon: ="Add"
                                    InteractionEnabled: =true
                                    NextStatus: =Blank()
                                    NextStatusData: |-
                                      ={
                                          StatusKey:          "DemandeBrouillon",
                                          StatutDetail:       "Brouillon de demande",
                                          StatutGeneral:      "Formulaire de demande",
                                          ProcessStepKey:     "InitDemande",
                                          ActionOwner:        {Key : "DFA",   Icon : "📝",       Text : "📝 DFA"},
                                          ActionRequired:     true,
                                          LinkedTypeDemande:  []
