sateur du traitement réalisé\n        Notify(\n            CountRows(dlstDemandes_M.SelectedItems) & \" demande(s) a/ont été envoyée(s) à la DFA\" ,\n            NotificationType.Success,2000\n        );     \n            \n        // Recharge les demandes afin de refléter immédiatement les changements de statut dans l'interface\n        Select(BtnLoadDemandes_M);\n        // Marque le processus comme terminé \n        // et adapte le filtre afin d'afficher les demandes dans leur nouveau statut\n                UpdateContext({\n            vcWizardStep:       numSendDFASave_M.Value + 1 ,\n            vcWizardCompleted:  true,\n            \n            // Conservation du mécanisme _DynamicOnStatus : \n            // les demandes restent visibles après traitement,\n            // mais désormais dans leur statut cible\n            vcApplyFilterOnStatus:      Table([MyNextStatus.Detail] , MyCurrentStatuses)\n        })\n));\n\n"
