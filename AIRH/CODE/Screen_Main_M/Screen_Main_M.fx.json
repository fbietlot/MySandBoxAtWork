Screens:
  Screen_Main_M:
    Properties:
      Fill: '=Color.White '
      OnVisible: |-
        =Concurrent(
            If(IsEmpty(ccTypeDeDemande),
                ClearCollect(ccTypeDeDemande, 
                                Choices([@AIRH_Demandes].'Type de demande')
                )
            ),
            If(IsEmpty(ccCategorieDocument),
                ClearCollect(ccCategorieDocument,
                                Choices([@AIRH_Documents].CategorieDocument)
                )
            ),
            If(vvUserRole.Key = Blank(),
                /*
                ## Configuration preload (notifications, contacts, etc.)
                - Loads configuration once to avoid repeated SharePoint calls
                - Used later for notification logic (per SPW)
                - but also for user context determination hereunder
                */
                ClearCollect(ccAIRH_DFA_DAC_Infos,
                    ShowColumns(
                        AIRH_DFA_DAC_Infos,
                        Role,ES,SPW,ContactPerson,AdditionnalContactEmail,IncorporationTemporaire
                    )
                );

                /*
                ## User profile initialization
                - Retrieves current user profile from M365
                - Stores it globally to avoid repeated connector calls
                */
                Set(vvUser,'Utilisateursd’Office365'.MyProfileV2());

                /*
                ## User ES extraction
                - Extracts the ES (department) from the user profile
                - Used as the primary key to determine SPW and role
                */
                With(
                    {MyUserES: vvUser.department},
                    /*
                    ## User configuration resolution
                    - Resolves user mapping based on ES first (standard case)
                    - Falls back to temporary incorporation if ES is not found
                    - Ensures every user can be mapped to a SPW and a Role
                    */
                    With(
                        {MyUserConfigByES:
                                LookUp(ccAIRH_DFA_DAC_Infos,!IsBlank(MyUserES) && MyUserES in ES.Value) 
                        },
                        Set(
                            vvUserConfig,
                            If(
                                !IsBlank(MyUserConfigByES),
                                MyUserConfigByES,
                                LookUp(ccAIRH_DFA_DAC_Infos,User().Email in IncorporationTemporaire.Email)
                            )
                        )
                    )
                );


                /*
                ## User context initialization
                - Exposes key properties for the rest of the app
                - Acts as a lightweight "current user context"
                */
                Set(vvUserSPW, vvUserConfig.SPW);
                Set(vvUserRole,  Switch( vvUserConfig.Role.Value, _Acteur.DFA.Key,_Acteur.DFA,_Acteur.DAC.Key,_Acteur.DAC,Blank()));


                /*
                ## Safety fallback
                - Prevents undefined behavior if no configuration is found
                - Allows controlled handling of edge cases
                */
                If(
                    IsBlank(vvUserConfig),
                    Notify(
                        "Votre rôle (DFA ou DAC) n’a pas pu être déterminé. Veuillez contacter le support.",
                        NotificationType.Error
                    )
                );
                // Initialize the current table configuration by applying actor-based visibility rules to the default catalog
                ClearCollect(ccDetailsListColumnsConfig,
                DropColumns(
                            Filter(
                            _tblDemandesFieldCatalog, 
                            vvUserRole.Key in View
                        ),View
                )
                );
            )

        );


        Switch(vcCurrentProcess,
            _ActionOnList.DACValider,
                Select(BtnLoadDemandes_M), // on recharge la liste avec le statut mis à jour mais on ne touche pas au filtre
            _ActionOnList.DirAudition,
                Select(BtnLoadDemandes_M), // on recharge la liste avec le statut mis à jour mais on ne touche pas au filtre
            _ActionOnList.CostraDecision,
                Select(BtnLoadDemandes_M), // on recharge la liste avec le statut mis à jour mais on ne touche pas au filtre
            _ActionOnList.CODIDecision,
                Select(BtnLoadDemandes_M), // on recharge la liste avec le statut mis à jour mais on ne touche pas au filtre
            _ActionOnList.GWDecision , 
                false, // Si on est en cours de process on ne doit pas recharger et reinitialiser
            _ActionOnList.CODIDecision , 
                false, // Si on est en cours de process on ne doit pas recharger et reinitialiser
            _ActionOnList.AddDoc,
                false, // Si on est en cours de process on ne doit pas recharger et reinitialiser

             //default
                UpdateContext({
                    vcCurrentProcess: Blank(),
                    vcApplyFilter: Blank()
                    }
                );

                UpdateContext({vcDefaultSort: true});
                If(IsBlank( vcDemandesSortField ) || vcDemandesSortField = "",
                    UpdateContext({
                        vcDemandesSortField: _DemandesFieldName.Modified,
                        vcDemandesSortOrder: false
                    })
                );

                Select(BtnLoadDemandes_M);
        );
    Children:
      - ctnMainContainer_M:
          Control: GroupContainer@1.5.0
          Variant: AutoLayout
          Properties:
            Fill: =RGBA(245, 245, 245, 1)
            Height: =Parent.Height
            LayoutAlignItems: =LayoutAlignItems.Stretch
            LayoutDirection: =LayoutDirection.Vertical
            LayoutGap: =16
            PaddingBottom: =16
            PaddingLeft: =16
            PaddingRight: =16
            PaddingTop: =16
            Width: =Parent.Width
          Children:
            - ctnHeaderContainer_M:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  AlignInContainer: =AlignInContainer.SetByContainer
                  FillPortions: =0
                  Height: =75
                  LayoutAlignItems: =LayoutAlignItems.Center
                  LayoutDirection: =LayoutDirection.Horizontal
                Children:
                  - Header_M_1:
                      Control: Header@0.0.44
                      Properties:
                        Title: "=_AppName & \" (version \" & _AppVersion &   \" - Rôle : \" & vvUserRole.Text & \" - SPW : \" & Coalesce(vvUserSPW,\"N/A\") & \")\" "
            - ctnActions_M:
                Control: GroupContainer@1.5.0
                Variant: AutoLayout
                Properties:
                  Fill: =RGBA(200, 200, 200, 1)
                  FillPortions: =0
                  Height: "=80\r\n+ Max(\r\n    ((vcCurrentProcess = _ActionOnList.NewDemande)) * ctnSubActionButtons.Height,\r\n    (vcCurrentProcess = _ActionOnList.Filtrer) * ctnFilters.Height,\r\n    (vcCurrentProcess = _ActionOnList.Archive) * ctnArchive_M.Height\r\n) \r\n+ vvDebug * ctnTechnicalButtons_M.Height  "
                  LayoutAlignItems: =LayoutAlignItems.Center
                  LayoutDirection: =LayoutDirection.Vertical
                  LayoutMaxWidth: =Parent.Width
                  LayoutMinHeight: =16
                  LayoutMinWidth: =16
                Children:
                  - ctnActionButtons:
                      Control: GroupContainer@1.5.0
                      Variant: AutoLayout
                      Properties:
                        BorderStyle: =BorderStyle.None
                        DropShadow: =DropShadow.None
                        Height: =80
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutGap: =8
                        LayoutMinHeight: =40
                        LayoutMinWidth: =64
                        PaddingBottom: =4
                        PaddingLeft: =4
                        PaddingRight: =4
                        PaddingTop: =4
                        Width: =Parent.Width
                      Children:
                        - ctnActionButtonsLeft:
                            Control: GroupContainer@1.5.0
                            Variant: AutoLayout
                            Properties:
                              BorderStyle: =BorderStyle.None
                              DropShadow: =DropShadow.None
                              LayoutDirection: =LayoutDirection.Horizontal
                              LayoutGap: =10
                              LayoutMinHeight: =40
                              LayoutMinWidth: =1000
