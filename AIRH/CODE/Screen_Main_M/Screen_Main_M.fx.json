                                    FontWeight: =FontWeight.Bold
                                    Layout: =ButtonLayout.TextOnly
                                    OnSelect: "=With(\n    { \n        MyNextStatusKey_V2 : _StatusDetailKey.PromRedaction,\n        MyNextStatus_V2 :  // Statut cible appliqué aux demandes après exécution\n            With (\n                { MyStatusConfig : LookUp(_StatutConfigTable,StatusKey = _StatusDetailKey.PromRedaction)},\n                {                                    \n                    Detail:   MyStatusConfig.StatutDetail,\n                    General:  MyStatusConfig.StatutGeneral\n                }\n            )\n    },\n    // # Applique le changement de statut à toutes les demandes sélectionnées\n    ForAll(dlstDemandes_M.SelectedItems,\n        Patch(AIRH_Demandes,\n            ShowColumns( ThisRecord,ID),\n            {\n                'Statut General':   MyNextStatus_V2.General,\n                'Statut Detail':    MyNextStatus_V2.Detail\n            }\n\n        )        \n    );\n\n    Concurrent(\n        // # envoi de notification pour cette action\n        // pas de notif\n        false\n        ,       \n        // # Trace chaque changement de statut dans l'historique\n        fxLogStatusHistory(\n            ShowColumns(dlstDemandes_M.SelectedItems,ID,NumEmploi),\n            MyNextStatus_V2, MyNextStatusKey_V2,\n            vvUserRole.Key\n        )\n    );\n\n    Notify(CountRows(dlstDemandes_M.SelectedItems) & \" demande(s) modifiée(s)\" ,NotificationType.Success,2000);     \n\n                \n    // # Recharge les données pour refléter les changements en UI\n    Select(BtnLoadDemandes_M);\n    // Advance the wizard to the confirmation/next stage\n    UpdateContext({\n        vcWizardStep: numPromRedacSave_M_1.Value + 1 ,\n        vcApplyFilterOnStatus: [_StatutDetail.PromRedaction , _StatutDetail.CandidPVTermines]\n    })\n);\n\n"
