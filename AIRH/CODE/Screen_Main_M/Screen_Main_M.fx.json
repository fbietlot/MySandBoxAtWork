                                              vcCurrentProcess :                  MyProcess,
                                              vcWizardStep :               1,
                                              vcWizardCompleted:          false,
                                              vcWizardStepAfterSelect :    0, // La plus part du temps après la selection d'une demande dans la liste on passe à l'étape 2 (sinon modifier cette valuer)
                                              vcApplyFilter :                     MyFilterToApply,
                                              vcApplyFilterOnStatus_V2:           Self.SourceStatusesData.StatusKey
