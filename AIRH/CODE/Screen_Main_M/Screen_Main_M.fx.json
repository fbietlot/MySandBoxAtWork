                                          FontWeight: =FontWeight.Bold
                                          Layout: =ButtonLayout.TextOnly
                                          OnSelect: "=Switch(radCOSTRAdecisionChoice_M.Selected.Value ,\n    _Decision.Validée,\n        With(\n            { \n                // Statut cible \n                //(à priori déclaré sur le bouton de lancement du processus)\n                MyNextStatus_V2:    LookUp(_StatutConfigTable,StatusKey = _StatusDetailKey.NGWAuGW),\n                // Statuts depuis lesquels le processus peut être exécuté \n                // (à priori déclaré sur le bouton de lancement du processus)\n                // (utilisés plus loin pour maintenir le filtre après traitement)\n                MyCurrentStatuses_V2:   cmpActBtnCOSTRADecision_M.SourceStatusesData\n            },\n\n            // # Applique le changement de statut à toutes les demandes sélectionnées\n            ForAll(dlstDemandes_M.SelectedItems,\n                Patch(AIRH_Demandes,\n                    ShowColumns( ThisRecord,ID),\n                    {\n                        StatusKey:          MyNextStatus_V2.StatusKey,\n                        'Statut Detail':    MyNextStatus_V2.StatutDetail,\n                        'Statut General':   MyNextStatus_V2.StatutGeneral\n                    }\n                )\n            );\n\n            Concurrent(\n                // # envoi de notification pour cette action\n                // # Aucun envoi de notification pour cette action\n                false\n                ,       \n                // # Trace chaque changement de statut dans l'historique\n                fxLogStatusHistory(\n                    ShowColumns(dlstDemandes_M.SelectedItems,ID,NumEmploi),\n                    MyNextStatus_V2.StatusKey,\n                    vvUserRole.Key\n                );\n            );\n                        \n            // Recharge les demandes afin de refléter immédiatement les changements de statut dans l'interface\n            Select(BtnLoadDemandes_M);\n\n            // Confirmation utilisateur du traitement réalisé\n            Notify(\n                CountRows(dlstDemandes_M.SelectedItems) & \" demande(s) a/ont été validées par le COSTRA\",\n                NotificationType.Success,2000\n            );\n\n            // Advance the wizard to the confirmation/next stage\n            UpdateContext({\n                vcWizardStep:    numCOSTRADecisionSAVE_M.Value + 1 ,\n                // Conservation du mécanisme _DynamicOnStatus : \n                // les demandes restent visibles après traitement,  mais désormais dans leur statut cible\n                vcApplyFilterOnStatus_V2:      Table({StatusKey : MyNextStatus_V2.StatusKey} , MyCurrentStatuses_V2.StatusKey)\n            })\n        );\n\n    ,   \n    _Decision.Refusée,\n    With(\n        { \n            // Statut cible \n            //(à priori déclaré sur le bouton de lancement du processus)\n            MyNextStatus_V2:    LookUp(_StatutConfigTable,StatusKey = _StatusDetailKey.COSTRARefusee),\n            // Statuts depuis lesquels le processus peut être exécuté \n            // (à priori déclaré sur le bouton de lancement du processus)\n            // (utilisés plus loin pour maintenir le filtre après traitement)\n            MyCurrentStatuses_V2:   cmpActBtnCOSTRADecision_M.SourceStatusesData\n        },\n        // Ouvre l'écran de traitement de la demande sélectionnée.\n        // Charge la demande complète ainsi que les configurations nécessaires\n        // afin d'initialiser correctement le contexte métier du formulaire.\n        With({ MyDemande :   dlstDemandes_M.Selected},\n            Navigate(Screen_Form_F,\n                Transition.Pop,\n                {\n                    vcDemande:              LookUp(AIRH_Demandes,           ID = dlstDemandes_M.Selected.ID ), // MyDemande.ID générait une erreur de delegation (probable faux positif du compilateur)\n                    // Indique que l’écran est ouvert en mode édition afin d’adapter l’interface et les boutons disponibles\n                    // Remarque : le mode des formulaires est piloté dynamiquement via vcStatutConfig afin de respecter les règles métier liées au statut\n                    vcScreenIsReadOnly :    false,\n                    vcTypeDemandeConfig :   LookUp(_TypeDemandeConfigTable, Type =  MyDemande.TypeDemandeValue),\n                    vcStatutConfig :        LookUp(_StatutConfigTable,      StatusKey = MyDemande.StatusKey),            \n                    vcPosteInformation:     Blank()     \n                }\n            );\n            UpdateContext({\n                    vcWizardStep:    numCOSTRADecisionSAVE_M.Value + 1 ,\n                    vcApplyFilterOnStatus_V2:      Table({StatusKey : MyNextStatus_V2.StatusKey} , MyCurrentStatuses_V2.StatusKey)\n                })\n        )\n    );\n)"
