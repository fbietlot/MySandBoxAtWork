                                          FontWeight: =FontWeight.Bold
                                          Layout: =ButtonLayout.TextOnly
                                          OnSelect: "=With({\n        // Statut cible \n        //(à priori déclaré sur le bouton de lancement du processus)\n        MyNextStatusDetail : cmpActBtnPromEnvoi_M.NextStatus, \n        // Statuts depuis lesquels le processus peut être exécuté \n        // (à priori déclaré sur le bouton de lancement du processus)\n        // (utilisés plus loin pour maintenir le filtre après traitement)\n        MyCurrentStatuses : cmpActBtnPromEnvoi_M.SourceStatuses\n    },\n    With(\n        { \n            // Reconstitue l'objet statut complet attendu par le modèle de données à partir du statut détail\n            MyNextStatus:                                 \n                {                                     \n                    Detail:   MyNextStatusDetail,\n                    General:  LookUp(_StatutConfigTable,StatutDetail = MyNextStatusDetail).StatutGeneral\n                }\n        },\n        // # Applique à toutes les demandes sélectionnées\n        //      - le changement de statut  \n        //      - les champs d'entrée complémentaires\n        ForAll(dlstDemandes_M.SelectedItems,\n            Patch(AIRH_Demandes,\n                ShowColumns( ThisRecord,ID),\n                {\n                    'Statut General':   MyNextStatus.General,\n                    'Statut Detail':    MyNextStatus.Detail\n                },\n                {\n                    DatePromSend: dtePromEnvoiDate_M.SelectedDate\n                }\n            )        \n        );\n\n        Concurrent(\n            // # envoi de notification pour cette action\n            ForAll(\n                // Envoi des notifications regroupées par SPW afin d'éviter l'envoi d'un email par demande\n                Distinct(dlstDemandes_M.SelectedItems,SPW) As MyCurrentSpw,\n                With({MyDemandeSPW : \n                        Filter(dlstDemandes_M.SelectedItems,SPW = MyCurrentSpw.Value)\n                    },\n                    With(\n                        {\n                            MyTypeDemande :     First(MyDemandeSPW).TypeDemandeValue,\n                            MyNbDemandes :      Value(CountRows(MyDemandeSPW)),\n                            MySpw :             MyCurrentSpw.Value,\n                            MyListeEmploiHtml : Concat( MyDemandeSPW,\"<li>\" & NumEmploi & \"</li>\" & Char(10) ),\n                            MyRecipients :      _DFAEmailList(MyCurrentSpw.Value)\n                        },\n                        If(IsBlank(MyRecipients),\n                            // Aucune liste DFA configurée pour ce SPW ou pour la DAC\n                            Notify(_txtMessage.NoRecipient, NotificationType.Warning,5000),\n                            // Envoi standard\n                            Office365Outlook.SendEmailV2(\n                                // To  : distribution list\n                                MyRecipients,\n                                // Subject: notification métier                   \n                                _txtMessage.EmailSubjectPrefix \n                                    &   \"Les arrêtés sont partis à la signature de l'Autorité\" ,     \n                                // Body: informations détaillées\n                                \"<p>Bonjour,</p> \" \n                                    & \"<i>[\" & MyTypeDemande & \"]: </i> Les arrêtés sont partis à la signature de l'Autorité pour les emplois suivants:\"\n                                    & \"<p><strong>\" & MySpw &\"</strong></p>\n                                        <ul>\"\n                                        & MyListeEmploiHtml\n                                        &\"</ul>\"                                      \n                                & _txtMessage.EmailFooter \n                            );\n                        )\n                    )\n                )\n            );\n            ,       \n            // # Trace chaque changement de statut dans